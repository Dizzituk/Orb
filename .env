# FILE: .env
# ASTRA Pipeline Configuration — Updated 2026-04-05
# Clean rewrite: legacy vars removed, modern {STAGE}_PROVIDER/{STAGE}_MODEL pattern

# =============================================================================
# ROUTER DEBUG MODE
# =============================================================================
ORB_ROUTER_DEBUG=1

# =============================================================================
# API KEYS
# =============================================================================
# OPENAI_API_KEY removed 2026-04-14 — now loaded from encrypted settings_api_keys store at startup
# ANTHROPIC_API_KEY removed 2026-04-14 — now loaded from encrypted settings_api_keys store at startup
# GOOGLE_API_KEY removed 2026-04-14 — now loaded from encrypted settings_api_keys store at startup

# =============================================================================
# MODEL CONFIGURATION — GENERAL DEFAULTS
# =============================================================================
OPENAI_DEFAULT_MODEL=gpt-5.4-mini
OPENAI_MODEL_LIGHT_CHAT=gpt-5.4-mini
OPENAI_MODEL_HEAVY_TEXT=gpt-5.4
OPENAI_MODEL_CRITICAL=gpt-5.5

# Anthropic
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_OPUS_MODEL=claude-opus-4-8
# 2026-06-11: Fable 5 ships blocking safety classifiers — the API returns
# stop_reason "refusal" (HTTP 200) and refusal rates are materially higher
# than prior models. When any Anthropic call hits a refusal, the registry
# retries ONCE with this model. Unset to disable the fallback retry.
ANTHROPIC_REFUSAL_FALLBACK_MODEL=claude-opus-4-8

# Google Gemini
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL_FAST=gemini-flash-latest
GEMINI_VISION_MODEL_COMPLEX=gemini-3.1-pro-preview
GEMINI_VIDEO_HEAVY_MODEL=gemini-3.1-pro-preview

# =============================================================================
# ASTRA PIPELINE — STAGE ASSIGNMENTS (modern pattern)
# =============================================================================
# Each stage uses {STAGE}_PROVIDER and {STAGE}_MODEL env vars.
# stage_models.py reads these first, falls back to STAGE_DEFAULTS if unset.
#
# Taz's assignments (2026-04-05):
#   Weaver:        GPT-5.4       (conversation + spec drafting)
#   Spec Gate:     Claude Opus   (spec validation + research)
#   Agentic/Impl:  GPT-5.4       (code generation + tool use)
#   Verifier:      Claude Opus   (verification + QA)

# -----------------------------------------------------------------------------
# Weaver (conversation, spec drafting)
# -----------------------------------------------------------------------------
WEAVER_PROVIDER=openai
WEAVER_MODEL=gpt-5.5

# -----------------------------------------------------------------------------
# Spec Gate (spec validation, requirements, codebase research)
# -----------------------------------------------------------------------------
# 2026-06-11: Moved to Claude Fable 5 at xhigh effort (one notch under max).
# Fable 5 notes: adaptive thinking is always on (no thinking config sent);
# sampling params (temperature/top_p) unsupported — registry strips them;
# refusal stop_reason handled with fallback (see ANTHROPIC_REFUSAL_FALLBACK_MODEL).
# max_tokens is a hard cap on thinking + visible output combined, so 64k per docs.
# xhigh requests can run for several minutes — timeout raised 120 -> 600.
SPEC_GATE_PROVIDER=anthropic
SPEC_GATE_MODEL=claude-fable-5
SPEC_GATE_REASONING_EFFORT=xhigh
SPEC_GATE_MAX_OUTPUT_TOKENS=64000
SPEC_GATE_TIMEOUT_SECONDS=600

# -----------------------------------------------------------------------------
# Planner (breaks work into chunks)
# -----------------------------------------------------------------------------
PLANNER_PROVIDER=openai
PLANNER_MODEL=gpt-5.5
PLANNER_MAX_OUTPUT_TOKENS=60000
PLANNER_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Implementer (writes/refactors code — agentic workflow)
# -----------------------------------------------------------------------------
IMPLEMENTER_PROVIDER=openai
IMPLEMENTER_MODEL=gpt-5.5
IMPLEMENTER_MAX_OUTPUT_TOKENS=60000
IMPLEMENTER_TIMEOUT_SECONDS=300

# -----------------------------------------------------------------------------
# Verifier / Overwatcher (verification + QA)
# -----------------------------------------------------------------------------
OVERWATCHER_PROVIDER=anthropic
OVERWATCHER_MODEL=claude-opus-4-8
OVERWATCHER_MAX_OUTPUT_TOKENS=4000
OVERWATCHER_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Architecture (generates architecture docs)
# -----------------------------------------------------------------------------
ARCHITECTURE_PROVIDER=anthropic
ARCHITECTURE_MODEL=claude-opus-4-7
ARCHITECTURE_MAX_OUTPUT_TOKENS=60000
ARCHITECTURE_TIMEOUT_SECONDS=300

# -----------------------------------------------------------------------------
# Critique (reviews architecture against spec)
# -----------------------------------------------------------------------------
CRITIQUE_PROVIDER=anthropic
CRITIQUE_MODEL=claude-opus-4-7
CRITIQUE_MAX_OUTPUT_TOKENS=60000
CRITIQUE_TIMEOUT_SECONDS=180

# -----------------------------------------------------------------------------
# Critical Pipeline
# -----------------------------------------------------------------------------
CRITICAL_PIPELINE_PROVIDER=openai
CRITICAL_PIPELINE_MODEL=gpt-5.5
CRITICAL_PIPELINE_MAX_OUTPUT_TOKENS=60000
CRITICAL_PIPELINE_TIMEOUT_SECONDS=600

# -----------------------------------------------------------------------------
# Streaming default
# -----------------------------------------------------------------------------
ANTHROPIC_STREAM_MAX_TOKENS=60000

# =============================================================================
# TRACKING & METRICS
# =============================================================================
ORB_TRACKING_ENABLED=1
ORB_LOG_TOKEN_USAGE=1
ORB_LOG_ROUTING_DECISIONS=1
ORB_LOG_CRITIQUE_DETAILS=1
ORB_LOG_REVISION_ITERATIONS=1
ORB_METRICS_DIR=D:\Orb\metrics
ORB_TRACK_JOB_COSTS=1

# =============================================================================
# AUDIT & DEBUG
# =============================================================================
ORB_AUDIT_ENABLED=1
ORB_DEBUG_LOGGING=1
ORB_MIN_CRITIQUE_CHARS=1500

# =============================================================================
# ZOBIE / ARCHMAP LOCAL TOOLS
# =============================================================================
ORB_ZOBIE_CONTROLLER_URL=http://192.168.250.2:8765
ORB_ZOBIE_MAPPER_SCRIPT=D:\tools\zobie_mapper\zobie_map.py
ORB_ZOBIE_MAPPER_OUT_DIR=D:\tools\zobie_mapper\out
ORB_ZOBIE_MAPPER_TIMEOUT_SEC=300
ORB_ZOBIE_MAPPER_ARGS=

# ARCHMAP LLM
ORB_ZOBIE_ARCHMAP_PROVIDER=anthropic
ORB_ZOBIE_ARCHMAP_MODEL=claude-opus-4-6

ORB_ZOBIE_ARCHMAP_TEMPLATE_MAX_CHARS=20000

# Multi-pass + file-first behavior
ORB_ZOBIE_ARCHMAP_MULTI_PASS=1
ORB_ZOBIE_ARCHMAP_WRITE_SECTIONS=1
ORB_ZOBIE_ARCHMAP_WRITE_FULL_FILE=1

# UI behavior
ORB_ZOBIE_ARCHMAP_STREAM_CONTENT=0
ORB_ZOBIE_ARCHMAP_SUMMARY_IN_SSE=1

# Hard bounds
ORB_ZOBIE_ARCHMAP_MAX_FILES=200000
ORB_ZOBIE_ARCHMAP_SECTION_MAX_CODE_FILES=120
ORB_ZOBIE_ARCHMAP_SECTION_MAX_CHARS_PER_FILE=18000
ORB_ZOBIE_ARCHMAP_SECTION_MAX_SCANNED_FILES=120
ORB_ZOBIE_ARCHMAP_MAX_ARTIFACT_CHARS=200000
ORB_ZOBIE_ARCHMAP_MAX_COMPLETION_TOKENS=6000

# Memory ingest
ORB_ZOBIE_ARCHMAP_INGEST_TO_MEMORY=1
ORB_ZOBIE_ARCHMAP_INGEST_SECTIONS_TO_MEMORY=1
ORB_ZOBIE_ARCHMAP_DOC_RAW_MAX_CHARS=60000

# ============================================================
# DEBUG ORCHESTRATOR — model routing per role
# ============================================================
# Decomposer + Planner = 'thinking' roles (full gpt-5.4 + reasoning_effort=high in code).
# Subagent/Executor = 'doing' roles (mini, no reasoning by design).
# CodeVerifier = heavy gpt-5.4 -- needs to understand code to catch breakage, but is
#   backstopped by smoke-gate + quarantine downstream, so doesn't need full 5.5.
#   (2026-06-19: dropped 5.5 -> 5.4 to trim fan-out-multiplied verify cost.)
# Without these, all roles silently fall back to OPENAI_DEFAULT_MODEL (mini).
DEBUG_DECOMPOSER_MODEL=gpt-5.5
DEBUG_PLANNER_MODEL=gpt-5.5
DEBUG_SUBAGENT_MODEL=gpt-5.4-mini
DEBUG_EXECUTOR_MODEL=gpt-5.4-mini
DEBUG_CODE_VERIFIER_MODEL=gpt-5.4
# Debug-tab orchestrator brain (added 2026-06-17). Without this it falls back to OPENAI_DEFAULT_MODEL (mini).
DEBUG_CHAT_MODEL=gpt-5.5

# MEMORY SYSTEM — model routing for extraction vs summarisation
# Summary model: cheap, just compresses conversation history
SUMMARY_PROVIDER=google
SUMMARY_MODEL=gemini-2.5-flash-lite
# Extraction model: needs comprehension to classify facts correctly
# (commitment vs aspiration, consequence weight, cross-domain recurrence).
# Uses separate config because extraction quality > extraction cost.
# Updated 2026-04-17 to gpt-5.4-mini per Taz's preferred cheap-but-capable tier
# (better linguistics handling than gpt-4.1-mini for the same kind of cost).
EXTRACTION_PROVIDER=openai
EXTRACTION_MODEL=gpt-5.4-mini

# =============================================================================
# IMAGE GENERATION (creative branch in image_router.py)
# =============================================================================
# Primary: gpt-image-2 — released 2026-04-21, autoregressive, near-perfect
# text rendering, reasoning-driven generation, up to 4K resolution.
# Switched from gpt-image-1.5 on 2026-04-25 for live testing.
# Falls back automatically to Google Nano Banana if primary fails (e.g. if
# the gpt-image-2 API isn't yet enabled for this org — early-May rollout window).
IMAGE_GEN_PROVIDER=openai
IMAGE_GEN_MODEL=gpt-image-2

# Fallback (Gemini Nano Banana)
IMAGE_GEN_FALLBACK_PROVIDER=google
IMAGE_GEN_FALLBACK_MODEL=gemini-2.5-flash-image

# -----------------------------------------------------------------------------
# Image output location (added 2026-04-25)
# -----------------------------------------------------------------------------
# Generated images now save here instead of D:\Orb\output\images so the
# file_watcher (which watches OneDrive\Pictures) picks them up. This means
# the agent's search_my_files / search_disk_live tools can find generated
# images when posting to Meta Business Suite etc., without needing to lift
# the gate around D:\Orb. Folder auto-created on first save.
# Forward slashes used to avoid backslash-escape ambiguity in .env parsing.
IMAGE_OUTPUT_DIR=C:/Users/dizzi/OneDrive/Pictures/AstraPictures

# =============================================================================
# CHAT ROUTING — FRONTIER MODEL FOR AGENTIC TABS  (added 2026-04-26, v14.1)
# =============================================================================
# Single source of truth for "the current best non-mini reasoning model".
# All smart routes (agentic tabs, cognitive escalation, file creation,
# reasoning tier) default to this. When gpt-5.5 (or whatever's next)
# ships, change FRONTIER_MODEL once and every smart route follows.
#
# Routes that auto-upgrade to FRONTIER:
#   • Agentic tabs    — ui_context.job in {website, courses, coursera,
#                       social, social_media, builds, project_builds,
#                       debug, debug_assistant}. Tab presence alone is
#                       enough; no message intent required.
#   • Cognitive cues  — "think about this", "take your time", etc.
#   • File creation   — "create me a webpage / document / file"
#   • Reasoning tier  — complexity classifier signals deep reasoning
#
# Default chat (Command Centre, casual ping-pong) stays on mini for
# speed/cost. The user's policy: as soon as I'm in an agentic tab,
# upgrade automatically; otherwise stay cheap.
FRONTIER_PROVIDER=openai
FRONTIER_MODEL=gpt-5.4

# Per-route overrides (rarely needed). If unset, the route falls back
# to FRONTIER_PROVIDER / FRONTIER_MODEL above. Uncomment to override:
# AGENTIC_CONTEXT_PROVIDER=anthropic
# AGENTIC_CONTEXT_MODEL=claude-opus-4-7
# COGNITIVE_ESCALATION_PROVIDER=openai
# COGNITIVE_ESCALATION_MODEL=gpt-5.4
# FILE_CREATION_PROVIDER=openai
# FILE_CREATION_MODEL=gpt-5.4
# REASONING_PROVIDER=openai
# REASONING_MODEL=gpt-5.4

# -----------------------------------------------------------------------------
# Reasoning effort for gpt-5.x / o-series models
# -----------------------------------------------------------------------------
# Pass-through to OpenAI's `reasoning_effort` parameter on chat.completions.
# Values: minimal | low | medium | high. Empty/unset disables it.
#
# Auto-skipped when (model is mini AND tools are present), because OpenAI
# rejects that combo on /v1/chat/completions with HTTP 400. So this is
# safe to leave on — mini chat keeps working, frontier-tier calls in
# agentic tabs get the reasoning budget they need for careful multi-step
# orchestration (e.g. browser flows where one wrong click breaks it).
OPENAI_REASONING_EFFORT=high

# -----------------------------------------------------------------------------
# Memory System (Phase 0 audit, 2026-05-02)
# -----------------------------------------------------------------------------

# Daily confidence-decay scheduler. Recomputes preference confidence,
# expires very-low-confidence preferences, and cleans stale hot index
# entries. Active default. Set to "false" to disable on next boot.
ASTRA_DECAY_SCHEDULER_ENABLED=true

# Master kill switch for auto-writes to identity.json.
# When set to 1/true, only sources prefixed with manual / user_confirmed
# / audit_fix / claude_audit_fix / manual_seed / smoke_test / phase can
# mutate the Tier 1 identity store. Phase 1 will tighten validators and
# split write paths via the arbiter, but until then this is the panic
# button if auto-extraction starts corrupting fields again.
# Leave commented out for normal operation; uncomment to engage.
# ASTRA_DISABLE_IDENTITY_AUTOWRITE=1

# Whether the LLM-based knowledge extractor (runs on session archive)
# is allowed to mirror its biographical extractions into the Tier 1
# identity store. Phase 1 audit (2026-05-02) defaults this OFF: this
# was the path that wrote `Grew up in Lagos, Algarve, Portugal.` into
# current_location, because the extractor LLM is fallible and there
# was no validation between its output and the Tier 1 store. Suppress
# mode still LOGS what would have been written so we get free training
# data for the Phase 3 arbiter. Default: false.
ASTRA_KNOWLEDGE_EXTRACTOR_IDENTITY_MIRROR=false

# Whether the chat-tool save_to_memory tool is allowed to mirror its
# biographical writes into the Tier 1 identity store. Phase 1 audit
# (2026-05-02) defaults this OFF for the same reason as the extractor
# mirror: the conversation LLM can call save_to_memory mid-turn and
# corrupt scalar identity fields with no human in the loop. The tool
# call still updates the PreferenceRecord (so the fact isn't lost),
# but the Tier 1 mirror is suppressed. The tool result includes
# identity_mirror="blocked_phase1" so the LLM knows to be careful in
# its reply. Default: false.
ASTRA_MEMORY_TOOLS_IDENTITY_WRITE=false

# -----------------------------------------------------------------------------
# Write Arbiter (Phase 3, 2026-05-02)
# -----------------------------------------------------------------------------

# Mode of the write arbiter for Tier 1 identity proposals.
#   shadow  - observe + log only (never changes identity.json).
#             Used for the first week of real-use validation.
#   enforce - act on decisions: queue Tier 1 proposals for human confirmation
#             via /self-model/proposals/{id}/accept|reject. No auto-commits.
#   off     - refuse all proposals (panic disable for the staging mechanism).
#
# Flipped to enforce on 2026-05-06 after a week of shadow-mode data showed
# the arbiter correctly caught two real corruptions from bridge:171 voice
# noise (current_location='Thanks so much harder Thanks' as hard contradiction;
# occupation='delivery driver getting squeezed' as soft contradiction queued
# for review). The Phase 1 regex validators didn't bounce them at write time;
# the arbiter would have stopped the first outright and queued the second.
ASTRA_ARBITER_MODE=enforce


# ─────────────────────────────────────────────────────────────────────
# ASTRA MODEL SELECTION  (canonical — edit here to change models)
# Primary = the cheaper everyday model. Fallback = pricier, used only if
# the primary fails. Resolved by app/llm/model_families.py (resolve/chain).
# Change a value + restart to apply. List available models any time with:
#   python -m app.llm.frontier_models
# ─────────────────────────────────────────────────────────────────────
# Everyday chat (text)
ASTRA_MODEL_ROLE_CHAT=gemini-3.5-flash
ASTRA_MODEL_ROLE_CHAT_FALLBACK=gpt-5.5
# Image + tool loop (screenshots, "log this to the work tab", etc.)
ASTRA_MODEL_ROLE_VISION_TOOLS=gemini-3.5-flash
ASTRA_MODEL_ROLE_VISION_TOOLS_FALLBACK=gpt-5.5
# High-volume classify / indexing / summaries (cheapest)
ASTRA_MODEL_ROLE_CHEAP=gemini-3.1-flash-lite
#
# Provider "tier" families (uncomment to override code defaults):
# ASTRA_MODEL_GOOGLE_FLAGSHIP=gemini-3.1-pro-preview
# ASTRA_MODEL_GOOGLE_BALANCED=gemini-3.5-flash
# ASTRA_MODEL_OPENAI_FLAGSHIP=gpt-5.5
#
# Pricing per 1M tokens (May 2026): gemini-3.5-flash $1.50/$9 |
#   gpt-5.5 $5/$30 | gemini-3.1-flash-lite $0.25/$1.50 | gemini-3.1-pro-preview $2/$12
# Options -> Gemini: gemini-3.5-flash | gemini-3.1-pro-preview | gemini-3.1-flash-lite | gemini-flash-latest
#            OpenAI: gpt-5.5 | gpt-5.4 | gpt-5.4-mini

# v2 agentic builder loop — was silently defaulting to gpt-5.4 via pipeline_v2/config.py (2026-06-09)
ASTRA_V2_BUILDER_MODEL=gpt-5.5
ASTRA_V2_FALLBACK_MODEL=claude-opus-4-8

# --- Memory roadmap Jobs 2-5 (2026-06-10) ---
# Job 3: semantic retrieval channel (embeddings merged into hot-index recall)
ASTRA_SEMANTIC_RETRIEVAL=true
ASTRA_SEMANTIC_MIN_SIM=0.55
ASTRA_SEMANTIC_TOP_K=40
# Jobs 4+5: lifestyle scheduler (nudge checkpoints + nightly habit learning, local times)
ASTRA_LIFESTYLE_SCHEDULER_ENABLED=true
ASTRA_NUDGE_CHECK_TIMES=13:30,19:15
ASTRA_HABIT_LEARN_TIME=02:40


# ASTRA Room v3 scene models (2026-06-13): Taz wants Gemini 3.5 for scene composition.
# gemini-3.1-pro-preview = google_flagship (PROVEN: video pipeline + multimodal chat). A real
# the code defaults (director + critic = anthropic:frontier-sonnet / claude-sonnet-4-6).
ASTRA_SCENE_DIRECTOR_PROVIDER=google
ASTRA_SCENE_DIRECTOR_MODEL=gemini-3.1-pro-preview
SCENE_CRITIC_PROVIDER=google
SCENE_CRITIC_MODEL=gemini-3.1-pro-preview


# ===================================================================
# Nat - local vLLM agent worker (added 2026-06-19, Nat build)
# Nat is served by a vLLM OpenAI-compatible server (runs in WSL2).
# Memory jobs reach Nat ONLY through these provider/model strings; swapping
# the backend later = change NAT_PROVIDER/VLLM_BASE_URL, nothing else.
# ===================================================================
NAT_PROVIDER=vllm_local
# Nat's model = Qwen2.5-3B-Instruct-AWQ (a QWEN model, NOT Gemma — despite the
# project nickname). Chosen 2026-06-20: fastest + right-sized for Nat's tiny
# classifier/injector role on the shared 4080 (Gemma-4-E4B was ~4x slower in vLLM
# via a forced TRITON_ATTN fallback, and its multimodal weights didn't fit).
# This value IS the vLLM --served-model-name; keep it == NAT_SERVED_NAME in
# scripts/nat/03_serve_nat.sh. See scripts/nat/README.md.
NAT_MODEL=qwen2.5-3b
NAT_MAX_CTX=8192
# vLLM OpenAI-compatible endpoint. 8001=TTS, 8002=Chatterbox, 8000=backend,
# 11434=ollama are taken; Nat uses 8003. localhost forwards into WSL2.
VLLM_BASE_URL=http://127.0.0.1:8003/v1
VLLM_API_KEY=EMPTY
VLLM_MAX_OUTPUT_TOKENS=1024
VLLM_TIMEOUT_SECONDS=60
VLLM_PRECHECK=0
# Native-thinking toggle key in the model chat template (gemma/qwen=enable_thinking)
NAT_THINKING_KWARG=enable_thinking
# --- Memory-job knobs (Part B) ---
# Job 2 pre-reply hard cap (ms); over this -> proceed with deterministic block only
NAT_ENRICHMENT_TIMEOUT_MS=900
# default output token cap for the small JSON jobs
NAT_JOB_MAX_TOKENS=200
# per-job kill switches (1=on, 0=off)
NAT_KEYWORDS_ENABLED=1
NAT_ENRICHMENT_ENABLED=1
NAT_IMPORTANCE_ENABLED=1


# ── LANE A VARS (2026-07-01) — chat routing & model resolution ─────────────
# Lane A de-hardcode: chat routing (app/llm/routing/*) and the frontier alias
# table (app/llm/frontier_models.py) now resolve EVERY model from .env.
# Changing any model = editing this file + restart. No code edits.

# Final fallback pair — any role/alias with no var of its own lands here.
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-5.4-mini

# Chat tier (TIER 1 — everyday Command Centre chat). Was hardcoded
# openai/gpt-5.4-mini; to move chat to Claude: CHAT_PROVIDER=anthropic,
# CHAT_MODEL=claude-sonnet-5 (launched 30 Jun 2026).
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-5.4-mini

# Architect tier (TIER 4). THE 2026-07-01 bug: this var was missing, so the
# stale hardcoded claude-opus-4-6 ran while the pipeline was already on
# Opus 4.8. Reconciled to the current Opus.
ARCHITECT_PROVIDER=anthropic
ARCHITECT_MODEL=claude-opus-4-8

# Reasoning tier (TIER 2) — also the model a held architect turn steps DOWN
# to (see TIER_MOMENTUM_STEPDOWN below).
REASONING_PROVIDER=openai
REASONING_MODEL=gpt-5.4

# Multimodal tiers (TIER 3).
IMAGE_VISION_PROVIDER=google
IMAGE_VISION_MODEL=gemini-2.5-pro
MULTIMODAL_PROVIDER=google
MULTIMODAL_MODEL=gemini-3.1-pro-preview-customtools

# Per-provider defaults — used when a provider goes down and routing swaps
# to whichever is available (ensure_provider_available). OPENAI_DEFAULT_MODEL
# already exists in the general-defaults section above.
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5
GOOGLE_DEFAULT_MODEL=gemini-2.5-flash

# Frontier alias table (app/llm/frontier_models.py) — one var per alias.
# These feed the PIPELINE stages (stage_models/pipeline_v2), not chat.
FRONTIER_OPENAI_REASONING_MODEL=gpt-5.4
FRONTIER_OPENAI_FAST_MODEL=gpt-5.4-mini
FRONTIER_ANTHROPIC_OPUS_THINKING_MODEL=claude-opus-4-8
FRONTIER_ANTHROPIC_OPUS_MODEL=claude-opus-4-8
# Verifier family (Fable 5 — export controls lifted 30 Jun 2026, alias
# resolves again). Was env-or-hardcoded; now env-only.
ASTRA_VERIFIER_FAMILY_MODEL=claude-fable-5
# Mid-tier Claude for lighter pipeline work. claude-sonnet-5 is out — bump
# here when ready.
FRONTIER_ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
FRONTIER_GOOGLE_FLASH_MODEL=gemini-2.5-flash
FRONTIER_GOOGLE_FLASH_LITE_MODEL=gemini-2.5-flash-lite

# Small-model tier (cognitive escalation escalates OFF these). Exact IDs
# listed here; a segment-anchored name heuristic (mini/nano/flash/lite/haiku)
# also applies, so new small models are usually caught without editing this.
ASTRA_SMALL_MODELS=gpt-5.4-mini,gpt-5-mini,gpt-5-nano,gpt-4.1-mini,gpt-4o-mini,claude-haiku-4-5,claude-haiku-3-5,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-flash-latest

# Conversational-vs-actionable gate: talking ABOUT the repo/memory/
# architecture no longer escalates the tier or diverts to the RAG answerer.
CONVERSATIONAL_GATE_ENABLED=1

# RAG-as-context (Lane A<->C contract): codebase questions stay in chat and
# the chat model answers in Astra's voice with a grounded block injected.
# 0 = legacy behaviour (raw RAG answer stream becomes the reply).
RAG_AS_CONTEXT_ENABLED=1
RAG_CONTEXT_TIMEOUT_S=20
RAG_CONTEXT_MAX_CHARS=3000

# Tier momentum retune (2026-07-01): DECAY 0.45 → a single architect spike
# holds ≤ 1 casual turn; STEPDOWN=1 → held casual turns after an architect
# turn run on the REASONING tier, never the top model.
TIER_MOMENTUM_DECAY=0.45
TIER_MOMENTUM_WINDOW=6
TIER_MOMENTUM_HOLD=1.0
TIER_MOMENTUM_STEPDOWN=1
TIER_MOMENTUM_SCORE_ARCHITECT=2.0
TIER_MOMENTUM_SCORE_REASONING=1.2
TIER_MOMENTUM_SCORE_EXPLORE=0.5
TIER_MOMENTUM_SCORE_CASUAL=0.0
# ── END LANE A VARS ───────────────────────────────────────────────────────

# ------ LANE C VARS (2026-07-01) - RAG answerer model tiers ------
# Previously hardcoded in app/rag/_answerer_model_selection.py; values below
# reproduce the old hardcoded behaviour EXACTLY. NOTE all three were already
# stale when de-hardcoded (sonnet-4-5 / opus-4-5 superseded; sonnet-5 is out) -
# bump them here, no code edit needed. Missing var -> DEFAULT_PROVIDER/DEFAULT_MODEL.
# ORB_RAG_MODEL (manual override, bypasses tiers) still works and stays unset.
RAG_LOOKUP_PROVIDER=openai
RAG_LOOKUP_MODEL=gpt-4.1-mini
RAG_REASONING_PROVIDER=anthropic
RAG_REASONING_MODEL=claude-sonnet-4-5-20250929
RAG_DEEP_PROVIDER=anthropic
RAG_DEEP_MODEL=claude-opus-4-5
# Embedding model label/selector for app/rag jobs (matches the live provider
# constant in app/embeddings/gemini_provider.py; unset -> that constant).
ORB_EMBEDDING_MODEL=gemini-embedding-2-preview
# ------ END LANE C VARS ------

# ── LANE B VARS (2026-07-01) — memory & whole-conversation recall ──
# Conversation overview/timeline ([CONVERSATION_TIMELINE]) served on whole-
# conversation meta questions ("summarise the whole day", "first messages").
ASTRA_CONV_OVERVIEW=1
ASTRA_CONV_OVERVIEW_FIRST_N=5
ASTRA_CONV_OVERVIEW_LAST_N=5
ASTRA_CONV_OVERVIEW_ANCHORS=6
ASTRA_CONV_OVERVIEW_PER_MSG_CHARS=280
ASTRA_CONV_OVERVIEW_MAX_CHARS=3600
# Rolling-summary caps (summary_generator) — previously hardcoded 10 items / 800 words.
ASTRA_SUMMARY_MAX_LIST_ITEMS=10
ASTRA_SUMMARY_MAX_WORDS=800
# conversation_arc tier: entries past this cap merge (never drop; opener always kept).
ASTRA_SUMMARY_ARC_MAX_ITEMS=20
