# FILE: app/content/video_pipeline/orchestrator.py
"""
Pipeline Orchestrator — chains all stages together.

Entry point for script-to-video generation. Manages:
1. Script analysis
2. Style resolution
3. Asset resolution (tiered cascade)
4. Narration generation (TTS)
5. EDL construction
6. FFmpeg assembly

Emits SSE progress events for the frontend.
"""
import os
import json
import uuid
import logging
import asyncio
from datetime import datetime, timezone
from typing import Optional, Callable, Awaitable, AsyncGenerator
from pathlib import Path

from sqlalchemy.orm import Session

from app.content.video_pipeline.models import (
    PipelineJobRequest, PipelineStageUpdate,
    ScenePlan, ResolvedPlan, StyleProfile,
)

logger = logging.getLogger(__name__)

JOBS_DIR = Path("data/content/video_pipeline/jobs")
TTS_OUTPUT_DIR = Path("data/content/video_pipeline/tts")


class PipelineJob:
    """Tracks state for a single pipeline execution."""

    def __init__(self, request: PipelineJobRequest):
        self.job_id = str(uuid.uuid4())[:12]
        self.request = request
        self.created_at = datetime.now(timezone.utc)
        self.status = "pending"
        self.current_stage = ""
        self.scene_plan: Optional[ScenePlan] = None
        self.resolved_plan: Optional[ResolvedPlan] = None
        self.style_profile: Optional[StyleProfile] = None
        self.output_path: Optional[str] = None
        self.total_cost_usd: float = 0.0
        self.error: Optional[str] = None
        self._events: list = []

    def record_event(self, stage: str, status: str, message: str = "", **data):
        event = PipelineStageUpdate(
            job_id=self.job_id,
            stage=stage,
            status=status,
            message=message,
            data=data,
        )
        self._events.append(event)
        return event

    @property
    def job_dir(self) -> Path:
        path = JOBS_DIR / self.job_id
        path.mkdir(parents=True, exist_ok=True)
        return path

    def save_state(self):
        """Persist job state to disk."""
        state = {
            "job_id": self.job_id,
            "status": self.status,
            "current_stage": self.current_stage,
            "created_at": self.created_at.isoformat(),
            "total_cost_usd": self.total_cost_usd,
            "output_path": self.output_path,
            "error": self.error,
            "request": self.request.model_dump(),
        }
        if self.scene_plan:
            state["scene_plan"] = self.scene_plan.model_dump()
        if self.resolved_plan:
            state["resolved_plan"] = self.resolved_plan.model_dump()

        state_file = self.job_dir / "state.json"
        state_file.write_text(
            json.dumps(state, indent=2, default=str),
            encoding="utf-8",
        )


async def run_pipeline(
    db: Session,
    request: PipelineJobRequest,
    event_callback: Optional[Callable[[PipelineStageUpdate], Awaitable]] = None,
) -> PipelineJob:
    """
    Execute the full script-to-video pipeline.

    Args:
        db: Database session for style profiles
        request: Pipeline job parameters
        event_callback: Async callback for SSE progress events

    Returns:
        PipelineJob with results
    """
    job = PipelineJob(request)
    job.status = "running"

    async def emit(stage, status, message="", **data):
        event = job.record_event(stage, status, message, **data)
        if event_callback:
            await event_callback(event)
        logger.info(f"[pipeline:{job.job_id}] {stage}: {status} — {message}")

    try:
        await emit("pipeline", "started", f"Job {job.job_id} started")

        # ── STAGE 1: Style Resolution ──
        job.current_stage = "style_resolution"
        await emit("style_resolution", "started")

        from app.content.video_pipeline.style_resolver import get_style_profile
        job.style_profile = get_style_profile(db, request.style_profile_id)
        await emit("style_resolution", "complete", f"Profile: {job.style_profile.profile_id or 'defaults'}")

        # ── STAGE 2: Script Analysis ──
        job.current_stage = "script_analysis"
        await emit("script_analysis", "started", "Analyzing script with Gemini")

        from app.content.video_pipeline.script_analyzer import analyze_script
        job.scene_plan = await analyze_script(
            script_text=request.script_text,
            title=request.title,
            target_platform=request.target_platform,
            target_duration_s=request.target_duration_s,
            style_profile=job.style_profile,
        )
        await emit(
            "script_analysis", "complete",
            f"{job.scene_plan.total_segments} segments, "
            f"~{job.scene_plan.estimated_total_duration_s:.0f}s",
        )
        # Update title from Gemini's analysis if user didn't provide one
        if (
            job.scene_plan.title
            and job.scene_plan.title.lower() not in (
                "untitled video", "untitled", ""
            )
            and request.title in ("Untitled Video", "", None)
        ):
            request.title = job.scene_plan.title
            logger.info(
                f"[pipeline:{job.job_id}] Title auto-set: '{request.title}'"
            )

        job.save_state()

        # ── STAGE 2.5: Director Pre-Production Review ──
        job.current_stage = "director_review"
        await emit("director_review", "started", "Director reviewing scene plan")

        from app.content.video_pipeline.director import (
            run_director_review, apply_director_notes,
        )
        direction = await run_director_review(
            scene_plan=job.scene_plan,
            style_profile=job.style_profile,
            target_platform=request.target_platform,
        )
        if direction:
            job.scene_plan = apply_director_notes(job.scene_plan, direction)
            hook = direction.get("hook_assessment", "unknown")
            score = direction.get("overall_quality_score", "?")
            ai_count = len(direction.get("ai_budget_segments", []))
            await emit(
                "director_review", "complete",
                f"Hook: {hook}, score: {score}/10, "
                f"AI segments: {ai_count}",
            )
        else:
            await emit("director_review", "complete", "Director skipped")

        job.save_state()

        # ── STAGE 3: Narration Generation (TTS) ──
        job.current_stage = "narration"
        await emit("narration", "started", "Generating narration audio")

        tts_dir = job.job_dir / "tts"
        tts_dir.mkdir(exist_ok=True)
        narration_map = await _generate_narration(
            job.scene_plan, str(tts_dir), emit,
        )
        await emit("narration", "complete", f"{len(narration_map)} audio files")

        # ═══════════════════════════════════════════════════
        # RENDER → QA → FIX LOOP (max 2 fix cycles)
        # If the QA gate scores below 8, re-resolve flagged segments
        # and re-assemble. Only the broken segments get re-rendered.
        # ═══════════════════════════════════════════════════
        from app.content.video_pipeline.asset_resolver import resolve_assets
        from app.content.video_pipeline.edl_builder import build_edl
        from app.content.production.edit_engine import execute_edl, check_ffmpeg
        from app.content.video_pipeline.director import run_qa_gate

        QA_PASS_THRESHOLD = 8
        MAX_FIX_CYCLES = 5

        if not check_ffmpeg():
            await emit("assembly", "error", "FFmpeg not installed")
            job.error = "FFmpeg not available"
            job.status = "failed"
            job.save_state()
            return job

        qa_score = 0
        output_path = None
        prev_clip_map = {}  # Futility guard: tracks previous clip assignments
        stuck_segments: set = set()  # Segments where stock footage can't satisfy QA

        for render_pass in range(1, MAX_FIX_CYCLES + 2):  # +2: 1 initial + 2 fixes
            pass_label = (
                "Initial render" if render_pass == 1
                else f"Fix cycle {render_pass - 1}/{MAX_FIX_CYCLES}"
            )

            # ── STAGE 4: Asset Resolution ──
            job.current_stage = "asset_resolution"
            await emit(
                "asset_resolution", "started",
                f"[{pass_label}] Resolving footage for each segment",
            )

            async def asset_progress(msg, pct):
                await emit("asset_resolution", "progress", msg, progress_pct=pct)

            job.resolved_plan = await resolve_assets(
                scene_plan=job.scene_plan,
                max_budget_usd=request.max_budget_usd,
                progress_callback=asset_progress,
                force_ai_segments=stuck_segments if stuck_segments else None,
            )
            job.total_cost_usd = job.resolved_plan.total_cost_usd
            await emit(
                "asset_resolution", "complete",
                f"Resolved {len(job.resolved_plan.assets)} assets, "
                f"cost: ${job.total_cost_usd:.2f}",
            )
            job.save_state()

            # ── Futility check: did any flagged segments get new clips? ──
            if prev_clip_map and render_pass > 1:
                new_clip_map = {}
                for asset in job.resolved_plan.assets:
                    if asset.segment_id in prev_clip_map:
                        new_clip_map[asset.segment_id] = (
                            os.path.abspath(asset.file_path)
                            if asset.file_path else ""
                        )
                stuck = [
                    sid for sid, old_path in prev_clip_map.items()
                    if new_clip_map.get(sid) == old_path
                ]
                if stuck and len(stuck) == len(prev_clip_map):
                    # ALL flagged segments returned the same clip.
                    # Re-rendering would produce identical output.
                    logger.info(
                        f"[pipeline:{job.job_id}] Futility guard: "
                        f"all {len(stuck)} flagged segments returned "
                        f"same clips. Skipping re-render."
                    )
                    await emit(
                        "qa_gate", "complete",
                        f"QA score: {qa_score}/10 — no new clips "
                        f"available for flagged segments. Best effort.",
                    )
                    break
                elif stuck:
                    # Mark stuck segments for fal.ai on next cycle
                    stuck_segments.update(stuck)
                    logger.info(
                        f"[pipeline:{job.job_id}] Futility guard: "
                        f"{len(stuck)} of {len(prev_clip_map)} flagged "
                        f"segments stuck: {stuck} — will force AI next cycle"
                    )

            # ── STAGE 4.5: Avatar Compositing ──
            # Composite HeyGen avatar clips onto a background image
            # so they don't appear on a plain dark background.
            from app.content.production.edit_engine import (
                composite_avatar_on_background,
            )

            composite_dir = job.job_dir / "composited"
            composite_dir.mkdir(exist_ok=True)
            composited_count = 0

            # Skip compositing — all current avatars have their
            # own scene backgrounds. No hardcoded IDs.
            # To re-enable compositing for a plain avatar, add
            # 'heygen_avatar_needs_compositing' = 'true' in settings.
            avatar_has_bg = os.getenv(
                "HEYGEN_AVATAR_NEEDS_COMPOSITING", "false"
            ).lower() not in ("true", "1", "yes")

            for asset in job.resolved_plan.assets:
                if asset.source.value != "heygen":
                    continue
                if not asset.file_path or not os.path.exists(asset.file_path):
                    continue

                comp_path = str(
                    composite_dir
                    / f"comp_{asset.segment_id}.mp4"
                )
                if avatar_has_bg:
                    # Avatar has its own background — skip compositing
                    logger.info(
                        f"[pipeline:{job.job_id}] Skipping compositing "
                        f"for {asset.segment_id} (avatar has own bg)"
                    )
                    continue

                bg_path = os.getenv("HEYGEN_AVATAR_BG_PATH", "")
                success = composite_avatar_on_background(
                    avatar_path=asset.file_path,
                    output_path=comp_path,
                    background_path=bg_path or None,
                )
                if success and os.path.exists(comp_path):
                    asset.file_path = comp_path
                    composited_count += 1

            if composited_count > 0:
                await emit(
                    "assembly", "progress",
                    f"Composited {composited_count} avatar clips "
                    f"onto background",
                )

            # ── STAGE 5: Storyboard Ready ──
            await emit(
                "storyboard_ready", "complete",
                f"[{pass_label}] Storyboard ready",
                segments=[a.model_dump() for a in job.resolved_plan.assets],
                total_cost=job.total_cost_usd,
            )

            # ── STAGE 6: EDL Construction ──
            job.current_stage = "edl_construction"
            await emit("edl_construction", "started", "Building edit timeline")

            edl = build_edl(
                scene_plan=job.scene_plan,
                resolved_plan=job.resolved_plan,
                narration_audio_paths=narration_map,
                style=job.style_profile,
                output_format=request.target_platform,
            )
            await emit(
                "edl_construction", "complete",
                f"{len(edl.segments)} EDL segments",
            )

            # ── Background music selection ──
            # Pick a random ambient track from the music folder.
            # Music is mixed at low volume (0.12) under the narration.
            music_dir = Path("data/content/video_pipeline/music")
            if music_dir.exists():
                import random as _music_rng
                tracks = (
                    list(music_dir.glob("*.mp3"))
                    + list(music_dir.glob("*.wav"))
                    + list(music_dir.glob("*.ogg"))
                    + list(music_dir.glob("*.flac"))
                    + list(music_dir.glob("*.m4a"))
                )
                if tracks:
                    chosen = _music_rng.choice(tracks)
                    edl.background_music_path = str(chosen)
                    edl.music_volume = 0.08  # very subtle, barely noticeable rise
                    logger.info(
                        f"[pipeline:{job.job_id}] Background music: "
                        f"{chosen.name} (volume={edl.music_volume})"
                    )

            # ── STAGE 6.5: Pre-Assembly Audio Merge ──
            if narration_map:
                await emit(
                    "assembly", "started",
                    f"[{pass_label}] Audio-first bake: building self-contained clips",
                )
                baked_count = await _bake_narration_into_clips(
                    edl=edl,
                    narration_map=narration_map,
                    scene_plan=job.scene_plan,
                    job_dir=str(job.job_dir),
                    emit=emit,
                    resolved_plan=job.resolved_plan,
                )
                await emit(
                    "assembly", "progress",
                    f"Baked {baked_count} clips (audio-first, {SCENE_GAP_S}s gaps)",
                )

            # ── STAGE 7: FFmpeg Assembly ──
            job.current_stage = "assembly"
            await emit(
                "assembly", "progress",
                f"[{pass_label}] Assembling video with FFmpeg",
            )

            output_path = execute_edl(edl)
            if not output_path:
                job.error = "FFmpeg assembly failed"
                job.status = "failed"
                await emit(
                    "assembly", "error",
                    "FFmpeg assembly returned no output",
                )
                job.save_state()
                return job

            job.output_path = output_path
            await emit(
                "assembly", "complete",
                f"[{pass_label}] Video saved: {output_path}",
            )

            # ── STAGE 8: Post-Production QA Gate ──
            job.current_stage = "qa_gate"
            await emit(
                "qa_gate", "started",
                f"[{pass_label}] Director reviewing assembled video",
            )

            # Build assembly summary with integrity checks
            # so the QA gate has real evidence to score against
            import subprocess as _sp

            summary_segments = []
            integrity_warnings = []

            for i, seg in enumerate(edl.segments):
                edl_dur = round(
                    seg.end_seconds - seg.start_seconds, 1
                )
                seg_info = {
                    "index": i,
                    "source": seg.source_path.split(os.sep)[-1],
                    "edl_duration_s": edl_dur,
                    "type": seg.segment_type,
                    "has_caption": bool(seg.caption_text),
                }

                # Check actual source file duration
                if os.path.exists(seg.source_path):
                    try:
                        probe = _sp.run(
                            [
                                "ffprobe", "-v", "quiet",
                                "-show_entries", "format=duration",
                                "-of", "csv=p=0",
                                os.path.abspath(seg.source_path),
                            ],
                            capture_output=True, text=True,
                            timeout=10,
                        )
                        actual_dur = round(
                            float(probe.stdout.strip()), 1
                        )
                        seg_info["actual_source_duration_s"] = actual_dur
                        if edl_dur > 0 and actual_dur > edl_dur + 1.0:
                            warning = (
                                f"seg_{i:03d}: EDL duration "
                                f"{edl_dur}s but source clip is "
                                f"{actual_dur}s — TRUNCATED by "
                                f"{round(actual_dur - edl_dur, 1)}s"
                            )
                            integrity_warnings.append(warning)
                            seg_info["WARNING"] = "TRUNCATED"
                    except Exception:
                        pass

                summary_segments.append(seg_info)

            assembly_summary = {
                "output_path": output_path,
                "total_segments": len(edl.segments),
                "total_duration_s": edl.total_duration,
                "total_cost_usd": job.total_cost_usd,
                "format": request.target_platform,
                "render_pass": render_pass,
                "segments": summary_segments,
            }

            if integrity_warnings:
                assembly_summary["INTEGRITY_WARNINGS"] = integrity_warnings
                logger.warning(
                    f"[pipeline:{job.job_id}] Assembly integrity: "
                    f"{len(integrity_warnings)} truncation warnings"
                )

            qa_result = await run_qa_gate(
                scene_plan=job.scene_plan,
                assembly_summary=assembly_summary,
            )

            qa_score = qa_result.get("overall_score", 5)
            qa_summary = qa_result.get("summary", "")
            qa_issues = qa_result.get("issues", [])

            # Store QA result
            job.scene_plan.metadata["qa_result"] = qa_result
            job.scene_plan.metadata[f"qa_result_pass_{render_pass}"] = qa_result

            # ── Check if QA passes ──
            if qa_score >= QA_PASS_THRESHOLD:
                await emit(
                    "qa_gate", "complete",
                    f"QA PASSED — score: {qa_score}/10. {qa_summary}",
                )
                break  # Exit the loop — video is good enough

            # ── QA failed — can we fix it? ──
            issue_summary = "; ".join(
                f"{i.get('segment_id', '?')}: "
                f"{i.get('description', '')[:50]}"
                for i in qa_issues[:3]
            )

            if render_pass > MAX_FIX_CYCLES:
                # Exhausted fix cycles — ship what we have
                await emit(
                    "qa_gate", "complete",
                    f"QA score: {qa_score}/10 after {MAX_FIX_CYCLES} fixes. "
                    f"Best effort — {issue_summary}",
                )
                break

            # ── Apply fixes: update search keywords for flagged segments ──
            await emit(
                "qa_gate", "progress",
                f"QA score: {qa_score}/10 — fixing {len(qa_issues)} issues. "
                f"{issue_summary}",
            )

            flagged_ids = set()
            segments_to_split = []  # (index, segment, issue)

            from app.content.video_pipeline.director import (
                split_long_segment,
            )

            for issue in qa_issues:
                seg_id = issue.get("segment_id", "")
                fix = issue.get("suggested_fix", "")
                desc = issue.get("description", "")
                if not seg_id:
                    continue
                flagged_ids.add(seg_id)

                for idx, seg in enumerate(job.scene_plan.segments):
                    if seg.segment_id != seg_id:
                        continue
                    if seg.requires_avatar:
                        logger.info(
                            f"[qa_fix] {seg_id}: skipping avatar "
                            f"segment (can't re-edit)"
                        )
                        break

                    # Check if this is a "too long" pacing issue
                    is_pacing = any(
                        w in desc.lower()
                        for w in [
                            "long", "prolonged", "single",
                            "static", "continuous", "pacing",
                        ]
                    )
                    dur = seg.estimated_duration_s
                    # Get actual TTS duration if available
                    tts_path = narration_map.get(seg.segment_id)
                    if tts_path and os.path.exists(tts_path):
                        import subprocess as _dur_sp
                        try:
                            _p = _dur_sp.run(
                                [
                                    "ffprobe", "-v", "quiet",
                                    "-show_entries",
                                    "format=duration",
                                    "-of", "csv=p=0",
                                    os.path.abspath(tts_path),
                                ],
                                capture_output=True, text=True,
                                timeout=10,
                            )
                            dur = float(_p.stdout.strip())
                        except Exception:
                            pass

                    if is_pacing and dur > 15:
                        # Queue this segment for splitting
                        segments_to_split.append(
                            (idx, seg, dur)
                        )
                        logger.info(
                            f"[qa_fix] {seg_id}: queued for split "
                            f"({dur:.0f}s, pacing issue)"
                        )
                    else:
                        logger.info(
                            f"[qa_fix] {seg_id}: keeping as-is "
                            f"(dur={dur:.0f}s, issue: {desc[:50]})"
                        )
                    break

            # Split long segments into sub-segments
            if segments_to_split:
                await emit(
                    "qa_gate", "progress",
                    f"Director splitting {len(segments_to_split)} "
                    f"long segments...",
                )

                # Process splits in reverse order so indices
                # stay valid as we insert new segments
                for idx, seg, dur in sorted(
                    segments_to_split, key=lambda x: x[0],
                    reverse=True,
                ):
                    sub_segs = await split_long_segment(
                        segment_id=seg.segment_id,
                        script_text=seg.script_text,
                        duration_s=dur,
                        keywords=seg.search_keywords,
                    )
                    if not sub_segs:
                        continue

                    # Create new SceneSegment objects from the
                    # Director's split
                    from app.content.video_pipeline.models import (
                        SceneSegment, SegmentType, AssetTier,
                        AvatarFraming,
                    )

                    new_segments = []
                    for i, sub in enumerate(sub_segs):
                        sub_id = f"{seg.segment_id}_{chr(97 + i)}"
                        new_seg = SceneSegment(
                            segment_id=sub_id,
                            segment_type=seg.segment_type,
                            script_text=sub.get(
                                "script_text", ""
                            ),
                            visual_description=sub.get(
                                "visual_description", ""
                            ),
                            search_keywords=sub.get(
                                "search_keywords", []
                            ),
                            mood_tags=seg.mood_tags,
                            estimated_duration_s=sub.get(
                                "estimated_duration_s", 8.0
                            ),
                            requires_avatar=False,
                            avatar_framing=AvatarFraming.NONE,
                            priority_tier=AssetTier.FREE_STOCK,
                        )
                        new_segments.append(new_seg)

                    # Replace the original segment with the
                    # sub-segments in the scene plan
                    job.scene_plan.segments[
                        idx:idx + 1
                    ] = new_segments
                    job.scene_plan.total_segments = len(
                        job.scene_plan.segments
                    )

                    # Generate TTS for each new sub-segment
                    tts_dir = job.job_dir / "tts"
                    for new_seg in new_segments:
                        if new_seg.script_text.strip():
                            sub_narration = await _generate_narration_single(
                                new_seg, str(tts_dir),
                            )
                            if sub_narration:
                                narration_map[
                                    new_seg.segment_id
                                ] = sub_narration

                    # Remove the old segment's TTS entry
                    narration_map.pop(seg.segment_id, None)

                    logger.info(
                        f"[qa_fix] Split {seg.segment_id} into "
                        f"{[s.segment_id for s in new_segments]}"
                    )

            await emit(
                "qa_gate", "progress",
                f"Re-rendering {len(flagged_ids)} flagged segments"
                f" ({len(segments_to_split)} split)...",
            )

            # ── Futility guard: detect stuck segments ──
            # Before re-resolving, record what clips flagged segments
            # currently have. After resolving, if a flagged segment
            # gets the same clip back, it's stuck — skip re-render.
            prev_clip_map = {}
            if job.resolved_plan:
                for asset in job.resolved_plan.assets:
                    if asset.segment_id in flagged_ids:
                        prev_clip_map[asset.segment_id] = (
                            os.path.abspath(asset.file_path)
                            if asset.file_path else ""
                        )

            logger.info(
                f"[pipeline:{job.job_id}] QA fix cycle {render_pass}: "
                f"re-resolving {flagged_ids}"
            )
            # Loop back to Stage 4 to re-resolve with updated keywords

        # ── Thumbnail Generation ──
        if job.output_path and os.path.exists(job.output_path):
            thumb_path = str(
                Path(job.output_path).parent / "thumbnail.png"
            )
            title = (
                getattr(job, "title", "")
                or getattr(job.request, "title", "")
                or (job.scene_plan.title if job.scene_plan else "")
                or "Untitled"
            )
            # AI-generated thumbnail from avatar still
            thumb_ok = await _generate_ai_thumbnail(
                scene_plan=job.scene_plan,
                edl=edl,
                title=title,
                output_path=thumb_path,
            )
            if not thumb_ok:
                # Fallback to b-roll frame thumbnail
                from app.content.production.thumbnail_gen import (
                    generate_thumbnail as gen_thumb,
                )
                gen_thumb(
                    video_path=job.output_path,
                    title=title,
                    output_path=thumb_path,
                )
            logger.info(
                f"[pipeline:{job.job_id}] Thumbnail: {thumb_path}"
            )

        # ── Mark all clips as used (90-day cooldown) ──
        if job.resolved_plan:
            from app.content.video_pipeline.asset_library import mark_clip_used
            for asset in job.resolved_plan.assets:
                if (
                    asset.file_path
                    and os.path.exists(asset.file_path)
                    and asset.source.value != "heygen"
                ):
                    mark_clip_used(asset.file_path)

        # ── DONE ──
        job.status = "complete"
        await emit(
            "pipeline", "complete",
            f"Pipeline finished — QA score: {qa_score}/10, "
            f"render passes: {render_pass}",
            output_path=job.output_path,
            total_cost=job.total_cost_usd,
        )

    except Exception as e:
        job.status = "failed"
        job.error = str(e)
        logger.exception(f"[pipeline:{job.job_id}] Pipeline failed: {e}")
        await emit("pipeline", "error", str(e))

    job.save_state()
    return job


# ---- Audio-First Bake ----
# PRINCIPLE: Audio is the master timeline. Video is wallpaper.
# - TTS audio is NEVER trimmed or re-encoded
# - Video is looped/trimmed to match audio duration + gap
# - Avatar clips (HeyGen) are self-contained, just get gap padding
# - Final assembly = simple concatenation of finished clips

SCENE_GAP_S = 0.75  # silence between scenes (like a full stop)


async def _generate_ai_thumbnail(
    scene_plan, edl, title: str, output_path: str,
) -> bool:
    """Generate a YouTube thumbnail using AI image generation.

    1. Extract a still from the avatar segment
    2. Send it to GPT Image 1.5 with a thumbnail design prompt
    3. Save the result as the video thumbnail
    """
    try:
        import subprocess as _sp
        import json as _json
        import base64

        # Find the first avatar segment's video file
        avatar_path = None
        for i, seg in enumerate(scene_plan.segments):
            if seg.requires_avatar and i < len(edl.segments):
                avatar_path = edl.segments[i].source_path
                break

        if not avatar_path or not os.path.exists(avatar_path):
            logger.warning("[thumbnail] No avatar segment found")
            return False

        # Get duration and extract frame at 40% (avatar mid-speech)
        try:
            r = _sp.run(
                [
                    "ffprobe", "-v", "error",
                    "-show_entries", "format=duration",
                    "-of", "json", avatar_path,
                ],
                capture_output=True, text=True, timeout=10,
            )
            dur = float(_json.loads(r.stdout)["format"]["duration"])
            seek = dur * 0.4
        except Exception:
            seek = 1.5

        # Extract frame as PNG
        temp_frame = output_path.replace(".png", "_avatar_frame.png")
        _sp.run(
            [
                "ffmpeg", "-y",
                "-ss", str(seek),
                "-i", avatar_path,
                "-frames:v", "1",
                "-q:v", "2",
                temp_frame,
            ],
            capture_output=True, timeout=10,
        )
        if not os.path.exists(temp_frame):
            return False

        # Encode avatar frame as base64 for the API
        with open(temp_frame, "rb") as f:
            avatar_b64 = base64.b64encode(f.read()).decode("utf-8")

        # Build the thumbnail prompt — NO TEXT in the AI image.
        # GPT Image can't reliably place text, so we generate the
        # background + avatar, then overlay text with Pillow.
        safe_title = title.replace('"', '').strip()
        prompt = (
            "Create a professional YouTube thumbnail background "
            "(1280x720). Feature the AI presenter from the attached "
            "image on the RIGHT side of the frame. The LEFT side "
            "should be empty dark space for text overlay later. "
            "DO NOT add any text, titles, or words to the image. "
            "STYLE: Dramatic cinematic lighting, dark tech background "
            "with subtle glowing elements, circuit patterns, "
            "depth of field. Professional and clean."
        )

        # Call GPT Image 1
        from openai import AsyncOpenAI
        api_key = os.getenv("OPENAI_API_KEY")
        if not api_key:
            logger.warning("[thumbnail] No OPENAI_API_KEY for AI thumbnail")
            return False

        client = AsyncOpenAI(api_key=api_key)
        response = await client.images.edit(
            model="gpt-image-1",
            image=open(temp_frame, "rb"),
            prompt=prompt,
            size="1536x1024",  # Closest to 16:9
        )

        # Save the result with Pillow text overlay
        if response.data and response.data[0].b64_json:
            img_bytes = base64.b64decode(response.data[0].b64_json)
            from PIL import Image, ImageDraw, ImageFont
            import io
            img = Image.open(io.BytesIO(img_bytes)).convert("RGB")
            img = img.resize((1280, 720), Image.LANCZOS)

            # Overlay title text with Pillow (pixel-perfect control)
            draw = ImageDraw.Draw(img)
            # Try Impact first, then Arial Bold
            font = None
            for fp in [
                "C:/Windows/Fonts/impact.ttf",
                "C:/Windows/Fonts/arialbd.ttf",
            ]:
                if os.path.exists(fp):
                    font = ImageFont.truetype(fp, 72)
                    break
            if not font:
                font = ImageFont.load_default()

            # Word wrap into lines that fit left 60% of frame
            title_upper = safe_title.upper()
            max_w = int(1280 * 0.55)  # text zone = left 55%
            words = title_upper.split()
            lines = []
            current = ""
            for word in words:
                test = (current + " " + word).strip()
                bbox = font.getbbox(test)
                if bbox[2] <= max_w:
                    current = test
                else:
                    if current:
                        lines.append(current)
                    current = word
            if current:
                lines.append(current)

            # Draw text with thick black outline + white fill
            # Vertically centred on the left side
            line_h = 80
            total_text_h = len(lines) * line_h
            y_start = (720 - total_text_h) // 2
            x_pos = 50  # 50px left margin

            for i, line in enumerate(lines[:5]):
                y = y_start + i * line_h
                # Black outline (3px)
                for ox in range(-3, 4):
                    for oy in range(-3, 4):
                        if ox == 0 and oy == 0:
                            continue
                        draw.text(
                            (x_pos + ox, y + oy), line,
                            font=font, fill=(0, 0, 0),
                        )
                # White text
                draw.text(
                    (x_pos, y), line,
                    font=font, fill=(255, 255, 255),
                )

            os.makedirs(os.path.dirname(output_path), exist_ok=True)
            img.save(output_path, "PNG")
            logger.info(
                f"[thumbnail] AI-generated thumbnail: {output_path}"
            )
            # Cleanup
            try:
                os.remove(temp_frame)
            except OSError:
                pass
            return True

        logger.warning("[thumbnail] AI image generation returned no data")
        return False

    except Exception as e:
        logger.warning(f"[thumbnail] AI thumbnail failed: {e}")
        return False


def _probe_duration(file_path: str) -> float:
    """Get duration of any media file via ffprobe."""
    import subprocess as _sp
    try:
        result = _sp.run(
            [
                "ffprobe", "-v", "quiet",
                "-show_entries", "format=duration",
                "-of", "csv=p=0",
                os.path.abspath(file_path),
            ],
            capture_output=True, text=True, timeout=15,
        )
        return float(result.stdout.strip())
    except Exception as e:
        logger.warning(f"[bake] Cannot probe {file_path}: {e}")
        return 0.0


# Ken Burns zoom percentage — how much to scale up for the
# slow zoom effect. 1.04 = 4% zoom, very subtle and smooth.
# Higher values cause visible jitter from integer pixel rounding.
KEN_BURNS_ZOOM = 1.04


def _bake_broll_segment(
    video_path: str,
    audio_path: str,
    output_path: str,
    segment_index: int = 0,
    key_phrase: str = "",
    filler_clips_dir: str = "data/content/video_pipeline/downloads/pexels",
    used_video_paths: Optional[set] = None,
    clip_b_path: str = "",
    clip_a_weight: float = 0.5,
) -> bool:
    """
    Bake a b-roll segment: audio is master, video fills.

    1. Probe audio duration (ground truth)
    2. Add SCENE_GAP_S for inter-scene pause
    3. If clip is shorter than audio, split time between
       the primary clip and a filler clip (no looping, no freezing)
    4. Apply subtle Ken Burns (slow zoom in/out) for visual energy
    5. Audio plays once in full, then silence for gap
    6. Output is exactly audio_duration + gap seconds
    """
    import subprocess as _sp

    audio_dur = _probe_duration(audio_path)
    if audio_dur <= 0:
        logger.warning(
            f"[bake] Audio duration is 0 for {audio_path}"
        )
        return False

    total_dur = audio_dur + SCENE_GAP_S
    abs_video = os.path.abspath(video_path)
    abs_audio = os.path.abspath(audio_path)

    # TWO-CLIP ARCHITECTURE: every b-roll segment gets the primary
    # clip first, then a second clip to fill remaining time.
    # If clip_b_query is set, download a specific second clip.
    # Otherwise grab a filler from the library.
    # This eliminates freezing AND makes segments more dynamic.
    clip_dur = _probe_duration(video_path)
    # Only use a second clip if the primary doesn't fill the segment.
    # Even if the director specified clip B, skip it when the primary
    # is long enough — one good clip is better than a forced split.
    needs_second_clip = clip_dur > 0 and clip_dur < total_dur - 0.5

    if needs_second_clip:
        import random as _filler_rng
        temp_dir = Path("data/content/temp")
        temp_dir.mkdir(exist_ok=True)
        abs_filler = None

        # Use pre-downloaded clip B if available
        if clip_b_path and os.path.exists(clip_b_path):
            abs_filler = os.path.abspath(clip_b_path)
            logger.info(
                f"[bake] Using director's clip B for seg "
                f"{segment_index}"
            )

        # Fallback: grab unused clip from library
        if not abs_filler:
            filler_dir = Path(filler_clips_dir)
            _used = used_video_paths or set()
            if filler_dir.exists():
                filler_candidates = [
                    f for f in filler_dir.glob("*.mp4")
                    if os.path.abspath(str(f)) != abs_video
                    and os.path.abspath(str(f)) not in _used
                ]
                if filler_candidates:
                    filler = _filler_rng.choice(filler_candidates)
                    abs_filler = os.path.abspath(str(filler))

        if abs_filler:
            # Split time using director's weight
            clip_a_dur = total_dur * clip_a_weight
            clip_b_dur = total_dur * (1.0 - clip_a_weight)
            # Don't let clip A exceed its actual length
            if clip_dur > 0:
                clip_a_dur = min(clip_a_dur, clip_dur)
            xfade_dur = 0.5  # half-second crossfade

            # Re-encode BOTH clips to 1920x1080 yuv420p so xfade
            # never chokes on codec/resolution/pixfmt mismatches.
            _norm = [
                "-vf", "scale=1920:1080:force_original_aspect_ratio="
                "decrease,pad=1920:1080:(ow-iw)/2:(oh-ih)/2,"
                "format=yuv420p",
                "-c:v", "libx264", "-preset", "fast",
                "-crf", "23", "-an",
            ]

            trim_a = str(temp_dir / f"trim_a_{segment_index:03d}.mp4")
            _sp.run(
                ["ffmpeg", "-y",
                 "-i", abs_video,
                 "-t", f"{clip_a_dur:.3f}"] + _norm + [trim_a],
                capture_output=True, text=True,
                timeout=60, encoding="utf-8", errors="replace",
            )

            trim_b = str(temp_dir / f"trim_b_{segment_index:03d}.mp4")
            _sp.run(
                ["ffmpeg", "-y",
                 "-i", abs_filler,
                 "-t", f"{clip_b_dur:.3f}"] + _norm + [trim_b],
                capture_output=True, text=True,
                timeout=60, encoding="utf-8", errors="replace",
            )

            # Crossfade: blend clip A into clip B
            xfade_path = str(
                temp_dir / f"xfade_{segment_index:03d}.mp4"
            )
            offset = max(clip_a_dur - xfade_dur, 0.1)
            xf_result = _sp.run(
                [
                    "ffmpeg", "-y",
                    "-i", trim_a,
                    "-i", trim_b,
                    "-filter_complex",
                    f"[0:v][1:v]xfade=transition=fade:"
                    f"duration={xfade_dur}:"
                    f"offset={offset:.3f}[v]",
                    "-map", "[v]",
                    "-c:v", "libx264", "-preset", "fast",
                    "-crf", "23",
                    xfade_path,
                ],
                capture_output=True, text=True,
                timeout=60, encoding="utf-8",
                errors="replace",
            )

            if (
                os.path.exists(xfade_path)
                and os.path.getsize(xfade_path) > 1000
            ):
                abs_video = os.path.abspath(xfade_path)
                logger.info(
                    f"[bake] Two-clip crossfade: "
                    f"{clip_a_dur:.1f}s A + "
                    f"{clip_b_dur:.1f}s B "
                    f"({xfade_dur}s fade)"
                )
            else:
                # Crossfade failed — concat the normalised trims
                concat_path = str(
                    temp_dir / f"concat_{segment_index:03d}.mp4"
                )
                concat_list = str(
                    temp_dir / f"concat_{segment_index:03d}.txt"
                )
                with open(concat_list, "w") as cl:
                    cl.write(f"file '{os.path.abspath(trim_a)}'\n")
                    cl.write(f"file '{os.path.abspath(trim_b)}'\n")
                _sp.run(
                    [
                        "ffmpeg", "-y",
                        "-f", "concat", "-safe", "0",
                        "-i", concat_list,
                        "-c", "copy", concat_path,
                    ],
                    capture_output=True, text=True,
                    timeout=30, encoding="utf-8",
                    errors="replace",
                )
                if os.path.exists(concat_path):
                    abs_video = os.path.abspath(concat_path)
                logger.info(
                    f"[bake] Two-clip concat (no fade): "
                    f"{clip_a_dur:.1f}s A + {clip_b_dur:.1f}s B"
                )

            if used_video_paths is not None:
                used_video_paths.add(abs_filler)

    # MULTI-CLIP FILL: if the video is STILL too short after the
    # two-clip concat, keep adding more clips from the library
    # until we have enough footage. No freezing, no looping.
    fill_round = 0
    while True:
        filled_dur = _probe_duration(abs_video) if os.path.exists(abs_video) else 0
        if filled_dur <= 0 or filled_dur >= total_dur - 0.5:
            break  # We have enough footage
        fill_round += 1
        if fill_round > 10:  # Safety: max 10 extra clips
            break
        import random as _fill_rng
        from app.content.video_pipeline.asset_library import is_clip_on_cooldown
        _fdir = Path(filler_clips_dir)
        _used = used_video_paths or set()
        _cands = [
            f for f in _fdir.glob("*.mp4")
            if os.path.abspath(str(f)) not in _used
            and not is_clip_on_cooldown(str(f))
        ] if _fdir.exists() else []
        if not _cands:
            break  # No more unused clips available
        _extra = _fill_rng.choice(_cands)
        _abs_extra = os.path.abspath(str(_extra))
        _temp_dir = Path("data/content/temp")
        _temp_dir.mkdir(exist_ok=True)
        # Re-encode the filler to 1920x1080 yuv420p so concat works
        _norm_extra = str(_temp_dir / f"fill_norm_{segment_index:03d}_{fill_round}.mp4")
        _remaining = max(total_dur - filled_dur, 1.0)
        _sp.run(
            [
                "ffmpeg", "-y", "-i", _abs_extra,
                "-t", f"{_remaining:.3f}",
                "-vf", "scale=1920:1080:force_original_aspect_ratio="
                "decrease,pad=1920:1080:(ow-iw)/2:(oh-ih)/2,"
                "format=yuv420p",
                "-c:v", "libx264", "-preset", "fast",
                "-crf", "23", "-an", _norm_extra,
            ],
            capture_output=True, text=True,
            timeout=60, encoding="utf-8", errors="replace",
        )
        if not os.path.exists(_norm_extra) or os.path.getsize(_norm_extra) < 100:
            break
        _fill_path = str(_temp_dir / f"fill_{segment_index:03d}_{fill_round}.mp4")
        _fill_list = str(_temp_dir / f"fill_{segment_index:03d}_{fill_round}.txt")
        with open(_fill_list, "w") as _fl:
            _fl.write(f"file '{abs_video}'\n")
            _fl.write(f"file '{os.path.abspath(_norm_extra)}'\n")
        _sp.run(
            [
                "ffmpeg", "-y",
                "-f", "concat", "-safe", "0",
                "-i", _fill_list,
                "-c", "copy", _fill_path,
            ],
            capture_output=True, text=True,
            timeout=30, encoding="utf-8", errors="replace",
        )
        if os.path.exists(_fill_path) and os.path.getsize(_fill_path) > 0:
            abs_video = os.path.abspath(_fill_path)
            if used_video_paths is not None:
                used_video_paths.add(_abs_extra)
            logger.info(
                f"[bake] Fill round {fill_round}: added "
                f"{_extra.name} ({filled_dur:.1f}s → "
                f"{_probe_duration(_fill_path):.1f}s)"
            )
        else:
            break

    # Gentle slow zoom for visual energy.
    # Simple scale-up + centre crop. No zoompan (it drops frames
    # on video inputs). The zoom is only 4% so pixel jitter is
    # invisible at this scale.
    z = KEN_BURNS_ZOOM
    sw = int(1920 * z)  # e.g. 1997
    sh = int(1080 * z)  # e.g. 1123
    mx = (sw - 1920) // 2  # margin ~38px
    my = (sh - 1080) // 2  # margin ~21px

    # Even segments: slow zoom in (crop moves inward)
    # Odd segments: slow zoom out (crop moves outward)
    if segment_index % 2 == 0:
        cx = f"{mx}*(1-t/{total_dur:.1f})"
        cy = f"{my}*(1-t/{total_dur:.1f})"
    else:
        cx = f"{mx}*(t/{total_dur:.1f})"
        cy = f"{my}*(t/{total_dur:.1f})"

    vf = (
        f"scale=1920:1080:force_original_aspect_ratio=decrease,"
        f"pad=1920:1080:(ow-iw)/2:(oh-ih)/2,"
        f"scale={sw}:{sh},"
        f"crop=1920:1080:{cx}:{cy}"
    )

    # Key phrase text overlay (lower-third, fade in/out)
    if key_phrase:
        safe_text = key_phrase.replace("'", "").replace("\\", "")
        font = "C\\\\:\\\\Windows\\\\Fonts\\\\segoeuib.ttf"
        # Fade in at 0.5s, fade out 1.5s before end
        vf += (
            f",drawtext=fontfile='{font}':"
            f"text='{safe_text}':"
            f"fontsize=36:fontcolor=white:"
            f"borderw=2:bordercolor=black@0.6:"
            f"x=(w-text_w)/2:y=h-80:"
            f"enable='between(t,0.5,{max(total_dur - 1.5, 1.0):.1f})':"
            f"alpha='if(lt(t,1.0),t-0.5,"
            f"if(gt(t,{max(total_dur - 2.0, 0.5):.1f}),"
            f"({total_dur - 1.5:.1f}-t+0.5),1))'"
        )

    # After two-clip concat, abs_video should be long enough.
    # No stream_loop — a brief freeze on the last frame is less
    # visible than a jarring loop back to the start of the clip.

    result = _sp.run(
        [
            "ffmpeg", "-y",
            "-i", abs_video,
            "-i", abs_audio,
            "-t", f"{total_dur:.3f}",
            "-vf", vf,
            "-c:v", "libx264", "-preset", "fast",
            "-crf", "23",
            "-ar", "44100", "-ac", "2",
            "-c:a", "aac", "-b:a", "192k",
            "-map", "0:v:0",
            "-map", "1:a:0",
            "-af", f"apad=whole_dur={total_dur}",
            "-vsync", "cfr",
            "-movflags", "+faststart",
            output_path,
        ],
        capture_output=True, text=True, timeout=120,
    )

    if result.returncode != 0:
        logger.warning(
            f"[bake] B-roll FFmpeg failed: "
            f"{result.stderr[-300:]}"
        )
        return False

    logger.info(
        f"[bake] B-roll: audio={audio_dur:.1f}s + "
        f"gap={SCENE_GAP_S}s = {total_dur:.1f}s"
    )
    return True


def _pad_avatar_segment(
    avatar_path: str,
    output_path: str,
) -> bool:
    """
    Pad avatar clip with SCENE_GAP_S of silence + frozen frame.

    Avatar clips from HeyGen are already video+audio synced.
    Just add a brief gap at the end for the inter-scene pause.
    """
    import subprocess as _sp

    avatar_dur = _probe_duration(avatar_path)
    if avatar_dur <= 0:
        logger.warning(
            f"[bake] Avatar duration 0 for {avatar_path}"
        )
        return False

    total_dur = avatar_dur + SCENE_GAP_S
    abs_avatar = os.path.abspath(avatar_path)

    # Do NOT use -t on the input — it truncates the avatar audio.
    # Instead: tpad extends video, apad extends audio, both to total_dur.
    result = _sp.run(
        [
            "ffmpeg", "-y",
            "-i", abs_avatar,
            "-vf",
            f"tpad=stop_mode=clone:stop_duration={SCENE_GAP_S}",
            "-af", f"apad=whole_dur={total_dur}",
            "-c:v", "libx264", "-preset", "fast",
            "-crf", "23",
            "-ar", "44100", "-ac", "2",
            "-c:a", "aac", "-b:a", "192k",
            "-vsync", "cfr",
            "-movflags", "+faststart",
            output_path,
        ],
        capture_output=True, text=True, timeout=120,
    )

    if result.returncode != 0:
        logger.warning(
            f"[bake] Avatar pad failed: "
            f"{result.stderr[-300:]}"
        )
        return False

    logger.info(
        f"[bake] Avatar: {avatar_dur:.1f}s + "
        f"gap={SCENE_GAP_S}s = {total_dur:.1f}s"
    )
    return True


async def _bake_narration_into_clips(
    edl,
    narration_map: dict,
    scene_plan: ScenePlan,
    job_dir: str,
    emit: Callable,
    resolved_plan: Optional["ResolvedPlan"] = None,
) -> int:
    """
    Audio-first bake: produce one self-contained clip per segment.

    Every output clip has:
    - Full audio (TTS for b-roll, embedded for avatar)
    - Video matched to audio duration
    - 0.5s silent gap at the end (natural pause)

    Final assembly just concatenates these clips. No sync issues
    possible because each clip is a complete, self-contained unit.

    Modifies edl.segments[].source_path in-place.
    Returns the number of clips baked.
    """
    job_path = Path(job_dir)
    baked_dir = job_path / "baked_clips"
    baked_dir.mkdir(exist_ok=True)

    baked_count = 0
    edl_idx = 0
    # Track all video paths used across segments so fillers
    # never duplicate clips already in the video.
    used_video_paths: set = set()

    for segment in scene_plan.segments:
        if edl_idx >= len(edl.segments):
            break

        edl_seg = edl.segments[edl_idx]
        audio_path = narration_map.get(segment.segment_id)
        baked_path = str(
            baked_dir / f"baked_{edl_idx:03d}.mp4"
        )

        if segment.requires_avatar:
            # Avatar: already has audio, just add gap
            src = os.path.abspath(edl_seg.source_path)
            success = _pad_avatar_segment(src, baked_path)
            if success:
                edl_seg.source_path = baked_path
                # Update EDL duration to match baked clip
                # so trim_clip doesn't cut off the gap
                new_dur = _probe_duration(baked_path)
                if new_dur > 0:
                    edl_seg.start_seconds = 0.0
                    edl_seg.end_seconds = new_dur
                baked_count += 1
                logger.info(
                    f"[bake_audio] Padded avatar "
                    f"{segment.segment_id}"
                )
            else:
                logger.warning(
                    f"[bake_audio] Avatar pad failed for "
                    f"{segment.segment_id}, using original"
                )

        elif audio_path and os.path.exists(audio_path):
            # B-roll: audio is master, video fills
            src = os.path.abspath(edl_seg.source_path)
            used_video_paths.add(src)  # track primary clip

            # Look up clip B path and duration weights
            clip_b_path = ""
            clip_a_weight = 0.5
            if resolved_plan:
                for asset in resolved_plan.assets:
                    if asset.segment_id == segment.segment_id:
                        clip_b_path = asset.metadata.get(
                            "clip_b_path", ""
                        )
                        break
            # Get duration weights from director's clip specs
            if len(segment.clips) >= 2:
                clip_a_weight = segment.clips[0].duration_weight

            success = _bake_broll_segment(
                src, audio_path, baked_path,
                segment_index=edl_idx,
                used_video_paths=used_video_paths,
                clip_b_path=clip_b_path,
                clip_a_weight=clip_a_weight,
            )
            if success:
                edl_seg.source_path = baked_path
                # Update EDL duration to match baked clip
                # so trim_clip doesn't cut off the gap
                new_dur = _probe_duration(baked_path)
                if new_dur > 0:
                    edl_seg.start_seconds = 0.0
                    edl_seg.end_seconds = new_dur
                baked_count += 1
                logger.info(
                    f"[bake_audio] Baked TTS into "
                    f"{segment.segment_id}"
                )
            else:
                logger.warning(
                    f"[bake_audio] B-roll bake failed for "
                    f"{segment.segment_id}, using original"
                )

        else:
            # No audio and not avatar — leave as-is
            logger.info(
                f"[bake_audio] No audio for "
                f"{segment.segment_id}, keeping original"
            )

        edl_idx += 1

    logger.info(
        f"[bake_audio] Complete: {baked_count}/{edl_idx} "
        f"clips baked (audio-first)"
    )
    return baked_count


async def _generate_narration_single(
    segment,
    output_dir: str,
) -> Optional[str]:
    """
    Generate TTS for a single segment. Used when the Director
    splits a long segment into sub-segments during a fix cycle.

    Returns the audio file path, or None on failure.
    """
    import httpx

    if not segment.script_text.strip():
        return None
    if segment.requires_avatar:
        return None

    heygen_key = os.getenv("HEYGEN_API_KEY", "")
    voice_id = os.getenv("HEYGEN_VOICE_ID", "")
    if not voice_id:
        try:
            from app.db import SessionLocal
            from app.settings.service import get_key_value
            with SessionLocal() as _db:
                voice_id = get_key_value(_db, "heygen_voice_id") or ""
        except Exception:
            pass

    out_dir = Path(output_dir)
    out_dir.mkdir(parents=True, exist_ok=True)
    output_path = out_dir / f"{segment.segment_id}.mp3"

    if heygen_key and voice_id:
        try:
            async with httpx.AsyncClient(timeout=30) as client:
                resp = await client.post(
                    "https://api.heygen.com/v1/audio/text_to_speech",
                    headers={
                        "X-Api-Key": heygen_key,
                        "Content-Type": "application/json",
                    },
                    json={
                        "text": segment.script_text,
                        "voice_id": voice_id,
                    },
                )
                if resp.status_code == 200:
                    tts_data = resp.json()
                    audio_url = (
                        tts_data.get("data", {})
                        .get("audio_url", "")
                    )
                    if audio_url:
                        audio_resp = await client.get(audio_url)
                        if audio_resp.status_code == 200:
                            output_path.write_bytes(audio_resp.content)
                            logger.info(
                                f"[narration] TTS for split segment "
                                f"{segment.segment_id}: "
                                f"{len(audio_resp.content) / 1024:.1f} KB"
                            )
                            return str(output_path)
        except Exception as e:
            logger.warning(
                f"[narration] TTS failed for {segment.segment_id}: {e}"
            )

    return None


async def _generate_narration(
    scene_plan: ScenePlan,
    output_dir: str,
    emit: Callable,
) -> dict:
    """
    Generate TTS narration for B-ROLL segments only.

    Uses HeyGen's Starfish TTS API with the same voice_id as the
    avatar (Alba) so the voice is consistent across the whole video.
    Avatar segments are SKIPPED — HeyGen embeds audio in those.

    Fallback: if HeyGen TTS fails, falls back to the local TTS server.

    Returns:
        narration_map: {segment_id: audio_file_path} for b-roll segments only
    """
    import httpx

    heygen_key = os.getenv("HEYGEN_API_KEY", "")
    voice_id = os.getenv("HEYGEN_VOICE_ID", "")

    # DB fallback for voice_id (same pattern as heygen_client)
    if not voice_id:
        try:
            from app.db import SessionLocal
            from app.settings.service import get_key_value
            with SessionLocal() as _db:
                voice_id = get_key_value(_db, "heygen_voice_id") or ""
        except Exception:
            pass

    use_heygen_tts = bool(heygen_key and voice_id)
    if use_heygen_tts:
        logger.info(
            f"[narration] Using HeyGen Starfish TTS "
            f"(voice_id={voice_id[:8]}...)"
        )
    else:
        logger.warning(
            "[narration] HeyGen TTS unavailable, falling back to local TTS"
        )

    # Fallback local TTS config
    local_tts_url = os.getenv("TTS_SERVER_URL", "http://localhost:8001")
    local_voice = os.getenv("TTS_DEFAULT_VOICE", "en-US-Neural2-D")

    narration_map = {}
    out_dir = Path(output_dir)
    out_dir.mkdir(parents=True, exist_ok=True)

    # TTS cache directory — persists across runs so identical
    # script text reuses the same audio file. Zero credits burned.
    tts_cache_dir = Path("data/content/video_pipeline/tts_cache")
    tts_cache_dir.mkdir(parents=True, exist_ok=True)

    generated = 0
    skipped_avatar = 0
    cached_hits = 0

    for i, segment in enumerate(scene_plan.segments):
        if not segment.script_text.strip():
            continue

        # Skip avatar segments — HeyGen embeds audio in the video
        if segment.requires_avatar:
            skipped_avatar += 1
            logger.info(
                f"[narration] Skipping {segment.segment_id}: "
                f"avatar segment (HeyGen provides audio)"
            )
            continue

        output_path = out_dir / f"{segment.segment_id}.mp3"

        # TTS CACHE: hash the script text + voice_id to create a
        # stable cache key. If the audio already exists, skip the API.
        import hashlib
        _cache_key = hashlib.sha256(
            f"{segment.script_text}|{voice_id}".encode()
        ).hexdigest()[:16]
        _cache_path = tts_cache_dir / f"tts_{_cache_key}.mp3"
        if _cache_path.exists() and _cache_path.stat().st_size > 100:
            # Copy from cache to job directory
            import shutil
            shutil.copy2(str(_cache_path), str(output_path))
            narration_map[segment.segment_id] = str(output_path)
            generated += 1
            cached_hits += 1
            logger.info(
                f"[narration] TTS CACHED for {segment.segment_id} "
                f"(hash={_cache_key})"
            )
            continue

        success = False

        # Try HeyGen Starfish TTS first (same voice as avatar)
        # Retry up to 3 times with a short delay between attempts.
        if use_heygen_tts:
            import asyncio as _aio
            max_retries = 5
            for _attempt in range(1, max_retries + 1):
                if success:
                    break
                try:
                    async with httpx.AsyncClient(timeout=30) as client:
                        resp = await client.post(
                            "https://api.heygen.com/v1/audio/text_to_speech",
                            headers={
                                "X-Api-Key": heygen_key,
                                "Content-Type": "application/json",
                            },
                            json={
                                "text": segment.script_text,
                                "voice_id": voice_id,
                            },
                        )
                        if resp.status_code == 200:
                            tts_data = resp.json()
                            audio_url = (
                                tts_data.get("data", {})
                                .get("audio_url", "")
                            )
                            if audio_url:
                                audio_resp = await client.get(audio_url)
                                if audio_resp.status_code == 200:
                                    output_path.write_bytes(
                                        audio_resp.content
                                    )
                                    narration_map[
                                        segment.segment_id
                                    ] = str(output_path)
                                    generated += 1
                                    success = True
                                    # Save to TTS cache for future runs
                                    try:
                                        import shutil as _shutil
                                        _shutil.copy2(
                                            str(output_path),
                                            str(_cache_path),
                                        )
                                    except Exception:
                                        pass
                                    logger.info(
                                        f"[narration] HeyGen TTS "
                                        f"{segment.segment_id}: "
                                        f"{len(audio_resp.content) / 1024:.1f} KB"
                                    )
                                else:
                                    logger.warning(
                                        f"[narration] HeyGen audio download "
                                        f"failed: {audio_resp.status_code}"
                                    )
                            else:
                                logger.warning(
                                    f"[narration] HeyGen TTS returned no "
                                    f"audio_url for {segment.segment_id}"
                                )
                        else:
                            logger.warning(
                                f"[narration] HeyGen TTS failed for "
                                f"{segment.segment_id}: {resp.status_code} "
                                f"(attempt {_attempt}/{max_retries})"
                            )
                except Exception as e:
                    logger.warning(
                        f"[narration] HeyGen TTS request failed: {e} "
                        f"(attempt {_attempt}/{max_retries})"
                    )
                # Wait before retrying (2s, 4s)
                if not success and _attempt < max_retries:
                    await _aio.sleep(2 * _attempt)

        # No fallback. Wrong voice = broken video.
        # If all 5 retries failed, abort the entire pipeline.
        if not success:
            error_msg = (
                f"HeyGen TTS FAILED after {max_retries} attempts "
                f"for {segment.segment_id}. Pipeline aborted — "
                f"cannot produce video with inconsistent voice."
            )
            logger.error(f"[narration] {error_msg}")
            raise RuntimeError(error_msg)

        if generated % 5 == 0 and generated > 0:
            await emit(
                "narration", "progress",
                f"Generated {generated} narrations "
                f"({skipped_avatar} avatar segments skipped)",
            )

    logger.info(
        f"[narration] Complete: {generated} TTS generated "
        f"({cached_hits} from cache), "
        f"{skipped_avatar} avatar segments skipped"
    )
    return narration_map
