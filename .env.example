# FILE: .env.example
# ASTRA Pipeline Configuration — TEMPLATE (regenerated 2026-07-01, Lane A)
# Copy to .env and fill in. Every model the routing/pipeline code reads
# resolves from here — no model is hardcoded in code. Values below are the
# current 2026-07-01 frontier: claude-opus-4-8, claude-sonnet-5, gpt-5.5,
# gpt-5.4(-mini), gemini-3.x/2.5 family, claude-fable-5 (verifier).

# =============================================================================
# ROUTER DEBUG MODE
# =============================================================================
ORB_ROUTER_DEBUG=1

# =============================================================================
# API KEYS
# =============================================================================
# Production loads OPENAI/ANTHROPIC/GOOGLE keys from the encrypted
# settings_api_keys store at startup (they are NOT read from .env).
# For standalone scripts/tests you may set them here:
# OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# GOOGLE_API_KEY=your-key-here

# =============================================================================
# MODEL CONFIGURATION — GENERAL DEFAULTS
# =============================================================================
OPENAI_DEFAULT_MODEL=gpt-5.4-mini
OPENAI_MODEL_LIGHT_CHAT=gpt-5.4-mini
OPENAI_MODEL_HEAVY_TEXT=gpt-5.4
OPENAI_MODEL_CRITICAL=gpt-5.5

# Anthropic
ANTHROPIC_SONNET_MODEL=claude-sonnet-5
ANTHROPIC_OPUS_MODEL=claude-opus-4-8
# On an Anthropic refusal (stop_reason "refusal"), the registry retries ONCE
# with this model. Unset to disable the fallback retry.
ANTHROPIC_REFUSAL_FALLBACK_MODEL=claude-opus-4-8

# Google Gemini
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL_FAST=gemini-flash-latest
GEMINI_VISION_MODEL_COMPLEX=gemini-3.1-pro-preview
GEMINI_VIDEO_HEAVY_MODEL=gemini-3.1-pro-preview

# =============================================================================
# ASTRA PIPELINE — STAGE ASSIGNMENTS ({STAGE}_PROVIDER / {STAGE}_MODEL)
# =============================================================================
WEAVER_PROVIDER=openai
WEAVER_MODEL=gpt-5.5

SPEC_GATE_PROVIDER=anthropic
SPEC_GATE_MODEL=claude-fable-5
SPEC_GATE_REASONING_EFFORT=xhigh
SPEC_GATE_MAX_OUTPUT_TOKENS=64000
SPEC_GATE_TIMEOUT_SECONDS=600

PLANNER_PROVIDER=openai
PLANNER_MODEL=gpt-5.5
PLANNER_MAX_OUTPUT_TOKENS=60000
PLANNER_TIMEOUT_SECONDS=120

IMPLEMENTER_PROVIDER=openai
IMPLEMENTER_MODEL=gpt-5.5
IMPLEMENTER_MAX_OUTPUT_TOKENS=60000
IMPLEMENTER_TIMEOUT_SECONDS=300

OVERWATCHER_PROVIDER=anthropic
OVERWATCHER_MODEL=claude-opus-4-8
OVERWATCHER_MAX_OUTPUT_TOKENS=4000
OVERWATCHER_TIMEOUT_SECONDS=120

ARCHITECTURE_PROVIDER=anthropic
ARCHITECTURE_MODEL=claude-opus-4-8
ARCHITECTURE_MAX_OUTPUT_TOKENS=60000
ARCHITECTURE_TIMEOUT_SECONDS=300

CRITIQUE_PROVIDER=anthropic
CRITIQUE_MODEL=claude-opus-4-8
CRITIQUE_MAX_OUTPUT_TOKENS=60000
CRITIQUE_TIMEOUT_SECONDS=180

CRITICAL_PIPELINE_PROVIDER=openai
CRITICAL_PIPELINE_MODEL=gpt-5.5
CRITICAL_PIPELINE_MAX_OUTPUT_TOKENS=60000
CRITICAL_PIPELINE_TIMEOUT_SECONDS=600

ANTHROPIC_STREAM_MAX_TOKENS=60000

# =============================================================================
# TRACKING & METRICS / AUDIT & DEBUG
# =============================================================================
ORB_TRACKING_ENABLED=1
ORB_LOG_TOKEN_USAGE=1
ORB_LOG_ROUTING_DECISIONS=1
ORB_LOG_CRITIQUE_DETAILS=1
ORB_LOG_REVISION_ITERATIONS=1
ORB_METRICS_DIR=D:\Orb\metrics
ORB_TRACK_JOB_COSTS=1
ORB_AUDIT_ENABLED=1
ORB_DEBUG_LOGGING=1
ORB_MIN_CRITIQUE_CHARS=1500

# =============================================================================
# ZOBIE / ARCHMAP LOCAL TOOLS
# =============================================================================
ORB_ZOBIE_CONTROLLER_URL=http://192.168.250.2:8765
ORB_ZOBIE_MAPPER_SCRIPT=D:\tools\zobie_mapper\zobie_map.py
ORB_ZOBIE_MAPPER_OUT_DIR=D:\tools\zobie_mapper\out
ORB_ZOBIE_MAPPER_TIMEOUT_SEC=300
ORB_ZOBIE_MAPPER_ARGS=
ORB_ZOBIE_ARCHMAP_PROVIDER=anthropic
ORB_ZOBIE_ARCHMAP_MODEL=claude-opus-4-8
ORB_ZOBIE_ARCHMAP_TEMPLATE_MAX_CHARS=20000
ORB_ZOBIE_ARCHMAP_MULTI_PASS=1
ORB_ZOBIE_ARCHMAP_WRITE_SECTIONS=1
ORB_ZOBIE_ARCHMAP_WRITE_FULL_FILE=1
ORB_ZOBIE_ARCHMAP_STREAM_CONTENT=0
ORB_ZOBIE_ARCHMAP_SUMMARY_IN_SSE=1
ORB_ZOBIE_ARCHMAP_MAX_FILES=200000
ORB_ZOBIE_ARCHMAP_SECTION_MAX_CODE_FILES=120
ORB_ZOBIE_ARCHMAP_SECTION_MAX_CHARS_PER_FILE=18000
ORB_ZOBIE_ARCHMAP_SECTION_MAX_SCANNED_FILES=120
ORB_ZOBIE_ARCHMAP_MAX_ARTIFACT_CHARS=200000
ORB_ZOBIE_ARCHMAP_MAX_COMPLETION_TOKENS=6000
ORB_ZOBIE_ARCHMAP_INGEST_TO_MEMORY=1
ORB_ZOBIE_ARCHMAP_INGEST_SECTIONS_TO_MEMORY=1
ORB_ZOBIE_ARCHMAP_DOC_RAW_MAX_CHARS=60000

# ============================================================
# DEBUG ORCHESTRATOR — model routing per role
# ============================================================
DEBUG_DECOMPOSER_MODEL=gpt-5.5
DEBUG_PLANNER_MODEL=gpt-5.5
DEBUG_SUBAGENT_MODEL=gpt-5.4-mini
DEBUG_EXECUTOR_MODEL=gpt-5.4-mini
DEBUG_CODE_VERIFIER_MODEL=gpt-5.4
DEBUG_CHAT_MODEL=gpt-5.5

# MEMORY SYSTEM — model routing for extraction vs summarisation
SUMMARY_PROVIDER=google
SUMMARY_MODEL=gemini-2.5-flash-lite
EXTRACTION_PROVIDER=openai
EXTRACTION_MODEL=gpt-5.4-mini

# =============================================================================
# IMAGE GENERATION
# =============================================================================
IMAGE_GEN_PROVIDER=openai
IMAGE_GEN_MODEL=gpt-image-2
IMAGE_GEN_FALLBACK_PROVIDER=google
IMAGE_GEN_FALLBACK_MODEL=gemini-2.5-flash-image
IMAGE_OUTPUT_DIR=C:/Users/you/OneDrive/Pictures/AstraPictures

# =============================================================================
# CHAT ROUTING — FRONTIER MODEL FOR AGENTIC TABS
# =============================================================================
# Single source of truth for "the current best non-mini reasoning model".
# Smart routes (agentic tabs, cognitive escalation, file creation, reasoning
# tier) fall back to this pair when their per-route vars are unset.
FRONTIER_PROVIDER=openai
FRONTIER_MODEL=gpt-5.4

# Per-route overrides (unset -> FRONTIER_*):
# AGENTIC_CONTEXT_PROVIDER=anthropic
# AGENTIC_CONTEXT_MODEL=claude-opus-4-8
# COGNITIVE_ESCALATION_PROVIDER=openai
# COGNITIVE_ESCALATION_MODEL=gpt-5.4
# FILE_CREATION_PROVIDER=openai
# FILE_CREATION_MODEL=gpt-5.4
# IMAGE_CHAT_PROVIDER=openai
# IMAGE_CHAT_MODEL=gpt-5.4

# Reasoning effort pass-through for gpt-5.x (minimal|low|medium|high)
OPENAI_REASONING_EFFORT=high

# -----------------------------------------------------------------------------
# Memory system switches
# -----------------------------------------------------------------------------
ASTRA_DECAY_SCHEDULER_ENABLED=true
# ASTRA_DISABLE_IDENTITY_AUTOWRITE=1
ASTRA_KNOWLEDGE_EXTRACTOR_IDENTITY_MIRROR=false
ASTRA_MEMORY_TOOLS_IDENTITY_WRITE=false
ASTRA_ARBITER_MODE=enforce

# ─────────────────────────────────────────────────────────────────────
# ASTRA MODEL SELECTION (model_families.py roles)
# ─────────────────────────────────────────────────────────────────────
ASTRA_MODEL_ROLE_CHAT=gemini-3.5-flash
ASTRA_MODEL_ROLE_CHAT_FALLBACK=gpt-5.5
ASTRA_MODEL_ROLE_VISION_TOOLS=gemini-3.5-flash
ASTRA_MODEL_ROLE_VISION_TOOLS_FALLBACK=gpt-5.5
ASTRA_MODEL_ROLE_CHEAP=gemini-3.1-flash-lite
# ASTRA_MODEL_GOOGLE_FLAGSHIP=gemini-3.1-pro-preview
# ASTRA_MODEL_GOOGLE_BALANCED=gemini-3.5-flash
# ASTRA_MODEL_OPENAI_FLAGSHIP=gpt-5.5

# v2 agentic builder loop
ASTRA_V2_BUILDER_MODEL=gpt-5.5
ASTRA_V2_FALLBACK_MODEL=claude-opus-4-8

# Memory roadmap Jobs 2-5
ASTRA_SEMANTIC_RETRIEVAL=true
ASTRA_SEMANTIC_MIN_SIM=0.55
ASTRA_SEMANTIC_TOP_K=40
ASTRA_LIFESTYLE_SCHEDULER_ENABLED=true
ASTRA_NUDGE_CHECK_TIMES=13:30,19:15
ASTRA_HABIT_LEARN_TIME=02:40

# ASTRA Room v3 scene models
ASTRA_SCENE_DIRECTOR_PROVIDER=google
ASTRA_SCENE_DIRECTOR_MODEL=gemini-3.1-pro-preview
SCENE_CRITIC_PROVIDER=google
SCENE_CRITIC_MODEL=gemini-3.1-pro-preview

# ===================================================================
# Nat - local vLLM agent worker
# ===================================================================
NAT_PROVIDER=vllm_local
NAT_MODEL=qwen2.5-3b
NAT_MAX_CTX=8192
VLLM_BASE_URL=http://127.0.0.1:8003/v1
VLLM_API_KEY=EMPTY
VLLM_MAX_OUTPUT_TOKENS=1024
VLLM_TIMEOUT_SECONDS=60
VLLM_PRECHECK=0
NAT_THINKING_KWARG=enable_thinking
NAT_ENRICHMENT_TIMEOUT_MS=900
NAT_JOB_MAX_TOKENS=200
NAT_KEYWORDS_ENABLED=1
NAT_ENRICHMENT_ENABLED=1
NAT_IMPORTANCE_ENABLED=1


# ── LANE A VARS (2026-07-01) — chat routing & model resolution ─────────────
# Chat routing (app/llm/routing/*) and the frontier alias table
# (app/llm/frontier_models.py) resolve EVERY model from .env. Changing any
# model = editing this file + restart. No code edits, ever.

# Final fallback pair — any role/alias with no var of its own lands here.
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-5.4-mini

# Chat tier (TIER 1 — everyday chat). For Claude chat use
# anthropic / claude-sonnet-5 (launched 30 Jun 2026).
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-5.4-mini

# Architect tier (TIER 4 — large-scale design turns).
ARCHITECT_PROVIDER=anthropic
ARCHITECT_MODEL=claude-opus-4-8

# Reasoning tier (TIER 2) — also the step-down target for held architect turns.
REASONING_PROVIDER=openai
REASONING_MODEL=gpt-5.4

# Multimodal tiers (TIER 3).
IMAGE_VISION_PROVIDER=google
IMAGE_VISION_MODEL=gemini-2.5-pro
MULTIMODAL_PROVIDER=google
MULTIMODAL_MODEL=gemini-3.1-pro-preview-customtools

# Per-provider defaults (availability fallback).
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5
GOOGLE_DEFAULT_MODEL=gemini-2.5-flash

# Frontier alias table (pipeline stages) — one var per alias.
FRONTIER_OPENAI_REASONING_MODEL=gpt-5.4
FRONTIER_OPENAI_FAST_MODEL=gpt-5.4-mini
FRONTIER_ANTHROPIC_OPUS_THINKING_MODEL=claude-opus-4-8
FRONTIER_ANTHROPIC_OPUS_MODEL=claude-opus-4-8
ASTRA_VERIFIER_FAMILY_MODEL=claude-fable-5
FRONTIER_ANTHROPIC_SONNET_MODEL=claude-sonnet-5
FRONTIER_GOOGLE_FLASH_MODEL=gemini-2.5-flash
FRONTIER_GOOGLE_FLASH_LITE_MODEL=gemini-2.5-flash-lite

# Small-model tier (cognitive escalation escalates OFF these). Exact IDs;
# a segment-anchored name heuristic (mini/nano/flash/lite/haiku) also applies.
ASTRA_SMALL_MODELS=gpt-5.4-mini,gpt-5-mini,gpt-5-nano,gpt-4.1-mini,gpt-4o-mini,claude-haiku-4-5,claude-haiku-3-5,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-flash-latest

# Conversational-vs-actionable gate: talking ABOUT the repo/memory/
# architecture never escalates the tier or diverts to the RAG answerer.
CONVERSATIONAL_GATE_ENABLED=1

# RAG-as-context: codebase questions stay in chat; the chat model answers in
# Astra's voice with a grounded block injected. 0 = legacy raw-RAG replies.
RAG_AS_CONTEXT_ENABLED=1
RAG_CONTEXT_TIMEOUT_S=20
RAG_CONTEXT_MAX_CHARS=3000

# Tier momentum: DECAY 0.45 → one architect spike holds ≤1 casual turn;
# STEPDOWN=1 → held turns run the REASONING tier, never the top model.
TIER_MOMENTUM_DECAY=0.45
TIER_MOMENTUM_WINDOW=6
TIER_MOMENTUM_HOLD=1.0
TIER_MOMENTUM_STEPDOWN=1
TIER_MOMENTUM_SCORE_ARCHITECT=2.0
TIER_MOMENTUM_SCORE_REASONING=1.2
TIER_MOMENTUM_SCORE_EXPLORE=0.5
TIER_MOMENTUM_SCORE_CASUAL=0.0
# ── END LANE A VARS ───────────────────────────────────────────────────────

# ------ LANE C VARS (2026-07-01) - RAG answerer model tiers ------
RAG_LOOKUP_PROVIDER=openai
RAG_LOOKUP_MODEL=gpt-4.1-mini
RAG_REASONING_PROVIDER=anthropic
RAG_REASONING_MODEL=claude-sonnet-5
RAG_DEEP_PROVIDER=anthropic
RAG_DEEP_MODEL=claude-opus-4-8
ORB_EMBEDDING_MODEL=gemini-embedding-2-preview
# ------ END LANE C VARS ------

# ── LANE B VARS (2026-07-01) — memory & whole-conversation recall ──
ASTRA_CONV_OVERVIEW=1
ASTRA_CONV_OVERVIEW_FIRST_N=5
ASTRA_CONV_OVERVIEW_LAST_N=5
ASTRA_CONV_OVERVIEW_ANCHORS=6
ASTRA_CONV_OVERVIEW_PER_MSG_CHARS=280
ASTRA_CONV_OVERVIEW_MAX_CHARS=3600
ASTRA_SUMMARY_MAX_LIST_ITEMS=10
ASTRA_SUMMARY_MAX_WORDS=800
ASTRA_SUMMARY_ARC_MAX_ITEMS=20

# ── IDLE-AGENTS VARS (2026-07-01) — local lane, governor, watchers, reports, research ──
# (This file is due a restructure under a separate job set; appended per convention.)

# Local provider lane (non-streaming registry, provider_id="local").
# Missing LOCAL_* values fall back to Nat's existing vars (VLLM_BASE_URL /
# NAT_MODEL / VLLM_API_KEY) — so this works today with no changes. When the
# 3090+Gemma workers land, point these three at the new endpoint; that is
# the entire migration.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8003/v1
LOCAL_LLM_DEFAULT_MODEL=qwen2.5-3b
LOCAL_LLM_API_KEY=EMPTY

# Idle governor — activity-based background work.
IDLE_MINUTES=10
ASTRA_IDLE_GOVERNOR_ENABLED=true
ASTRA_IDLE_POLL_SECONDS=15
ASTRA_IDLE_CATCHUP_MINUTES=10
ASTRA_REPO_MAP_CADENCE_HOURS=24

# Watchers (observe -> record -> summarise -> alert).
ASTRA_WATCHER_ALERT_PCT=10
# Region list JSON: [{"key":"...","label":"...","query":"..."}] — placeholders
# (central/coastal/interior) apply until Taz supplies exact areas.
#ASTRA_LAND_REGIONS=
ASTRA_LAND_PRICE_MIN=0.5
ASTRA_LAND_PRICE_MAX=1500
ASTRA_LAND_WATCH_CADENCE_HOURS=24
# Item list JSON: [{"key":"...","label":"...","query":"...","lo":0,"hi":0}]
#ASTRA_HARDWARE_ITEMS=
ASTRA_HARDWARE_WATCH_CADENCE_HOURS=24

# Reports pipeline (desktop reports window + Bridge document artifacts).
REPORTS_CACHE_DIR=D:\Orb\data\reports_cache
REPORTS_TTL_HOURS=24
ASTRA_REPORTS_DISPLAY_ALIAS=reports
ASTRA_BACKEND_BASE_URL=http://127.0.0.1:8000

# Deep research — depth budget replaces the fixed pass count for the
# background (idle-ledger) runs; DEEP_RESEARCH_MAX_ROUNDS still governs the
# interactive stream path.
DEEP_RESEARCH_MAX_FETCHES=25
DEEP_RESEARCH_MAX_MINUTES=20
DEEP_RESEARCH_MAX_LEADS_PER_ROUND=3
DEEP_RESEARCH_MAX_ROUNDS_BACKGROUND=8
DEEP_RESEARCH_EVIDENCE_PER_ROUND=12000

# ── Security hardening (2026-07-02) ──────────────────────────────────────
# Shared secret for local-trusted endpoints (presence/scene/voice/briefing/
# content-files). Loopback callers pass without it; non-loopback callers must
# send it as the X-Astra-Local header. Generate: 32+ random bytes, base64.
#ASTRA_LOCAL_SECRET=
# Socket peers allowed to speak for clients via X-Forwarded-For (the co-located
# reverse proxy). Comma-separated. Default: loopback only.
#ASTRA_TRUSTED_PROXY_IPS=127.0.0.1,::1
# Extra roots /rag/index may scan besides the default (ZOBIE_OUTPUT_DIR or
# D:\Orb\.architecture). Semicolon-separated absolute paths.
#ASTRA_RAG_SCAN_ROOTS=
# Session tokens older than this are rejected and pruned (default 720h = 30d).
ASTRA_SESSION_TTL_HOURS=720
# Bearer secret the sandbox controller (inside Windows Sandbox) requires on
# every request. Minted per-run by the sandbox manager — set only for manual
# controller testing; never reuse a value across runs.
#ASTRA_SANDBOX_SECRET=

## LANE E (2026-07-02) - local embeddings + 4080 orchestrator
EMBEDDINGS_TEXT_PROVIDER=local
EMBEDDINGS_TEXT_MODEL=qwen3-embedding-0.6b
EMBEDDINGS_TEXT_BASE_URL=http://127.0.0.1:8004/v1
EMBEDDINGS_TEXT_DIMS=1024
EMBEDDINGS_TEXT_QUERY_CUTOVER=0
EMBEDDINGS_TIMEOUT_SECONDS=30
EMBEDDINGS_MULTIMODAL_PROVIDER=gemini
#EMBEDDINGS_MULTIMODAL_MODEL=jina-embeddings-v4
#EMBEDDINGS_MULTIMODAL_BASE_URL=http://127.0.0.1:8005/v1
#EMBEDDINGS_MULTIMODAL_DIMS=1024
ASTRA_REEMBED_BATCH_SIZE=64
ASTRA_REEMBED_CADENCE_HOURS=6
ASTRA_VISUAL_DRAIN_CADENCE_HOURS=1
